# Copy to $IDENTITY_ENV_DIR/identity-bff.env with mode 0600.
# Single-quote secret values: Compose interpolates `$` in unquoted env_file values.
# PUBLIC_URL below means the deployment's https origin.
PORT=3000
KEYCLOAK_ORGANIZATION_REALM=digit
KEYCLOAK_SSL_REQUIRED=external
KEYCLOAK_ISSUER=<PUBLIC_URL>/auth/realms/digit
KEYCLOAK_OIDC_BACKCHANNEL_URL=http://keycloak:8180/realms/digit
KEYCLOAK_JWKS_URI=http://keycloak:8180/realms/digit/protocol/openid-connect/certs
KEYCLOAK_BFF_CLIENT_ID=digit-identity-bff
KEYCLOAK_BFF_AUDIENCE=digit-identity-bff
KEYCLOAK_BFF_CLIENT_SECRET=<generated>
KEYCLOAK_MAGIC_LINK_ENABLED=false
KEYCLOAK_MAGIC_LINK_CLIENT_ID=digit-identity-bff-magic-link
KEYCLOAK_MAGIC_LINK_CLIENT_SECRET=<generated independently>
# digit-ui sign-in surfaces (#2167). configure-keycloak.sh skips both clients
# until both secrets are set.
KEYCLOAK_EMPLOYEE_CLIENT_ID=digit-ui-employee
KEYCLOAK_EMPLOYEE_CLIENT_SECRET=<generated independently>
KEYCLOAK_CITIZEN_CLIENT_ID=digit-ui-citizen
KEYCLOAK_CITIZEN_CLIENT_SECRET=<generated independently>
IDENTITY_EMPLOYEE_SCOPE="openid profile email"
IDENTITY_CITIZEN_SCOPE="openid profile phone"
# Cookies default to IDENTITY_COOKIE_NAME + _employee / _citizen.
# IDENTITY_EMPLOYEE_COOKIE_NAME=digit_identity_session_employee
# IDENTITY_CITIZEN_COOKIE_NAME=digit_identity_session_citizen
# Required when magic links are enabled. Keep the password only in this 0600
# deployment file. A local catcher can use identity-mailpit:1025 with auth and
# STARTTLS false; production should use the deployment's real SMTP relay.
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=no-reply@example.org
KEYCLOAK_SMTP_FROM_DISPLAY_NAME="DIGIT Identity"
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_ADMIN_URL=http://keycloak:8180
KEYCLOAK_ADMIN_REALM=digit
KEYCLOAK_ADMIN_CLIENT_ID=digit-identity-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=<generated>
KEYCLOAK_ALLOWED_ORG_ROLE_CLIENTS=digit-ui
IDENTITY_REDIRECT_URI=<PUBLIC_URL>/identity/v1/callback
IDENTITY_POST_LOGIN_REDIRECT=<PUBLIC_URL>/configurator/login
IDENTITY_ALLOWED_ORIGINS=<PUBLIC_URL>
# Standalone nginx proxies directly to the BFF. The canonical Ansible stack
# overrides this to 2 for host nginx -> Kong -> BFF.
IDENTITY_TRUST_PROXY_HOPS=1
IDENTITY_LOGIN_TTL_SECONDS=1800
IDENTITY_MAGIC_LINK_REQUEST_WINDOW_SECONDS=1800
IDENTITY_MAGIC_LINK_REQUEST_LIMIT=3
# Installer inputs written to digit-identity-bff client attributes by
# configure-keycloak.sh. They are not read by the BFF process.
KEYCLOAK_BFF_SIGNIN_METHODS=password,google,github
KEYCLOAK_BFF_SIGNUP_METHODS=magic_link,google,github
KEYCLOAK_EMPLOYEE_LOGIN_THEME=digit-employee
KEYCLOAK_CITIZEN_LOGIN_THEME=digit-citizen
KEYCLOAK_EMPLOYEE_SIGNIN_METHODS=password
# Which citizen sign-in methods to offer is open (#2189); empty = none.
KEYCLOAK_CITIZEN_SIGNIN_METHODS=
IDENTITY_AUTH_RESULT_TTL_SECONDS=300
IDENTITY_PASSWORD_SETUP_TTL_SECONDS=900
IDENTITY_PASSWORD_SETUP_LIMIT=3
IDENTITY_COOKIE_SECURE=true
IDENTITY_CONTROL_PLANE_TOKEN=<generated; BFF operators/onboarding worker only>
IDENTITY_SESSION_INTROSPECTION_TOKEN=<generated; shared with PGR>
IDENTITY_ORGANIZATION_ADMIN_ROLES=TENANT_ADMIN
IDENTITY_ORGANIZATION_MEMBER_GROUP=employees
IDENTITY_RECONCILE_ON_STARTUP=true
IDENTITY_RECONCILIATION_INTERVAL_SECONDS=900
# Existing egov-user contract, reached through Kong so DIGIT RBAC applies.
DIGIT_USER_SERVICE_URL=http://kong:8000/user
DIGIT_MDMS_SEARCH_URL=http://kong:8000/mdms-v2/v1/_search
# Public tenant login branding (#2167): GET /identity/v1/tenant-contexts/{slug}/branding,
# read by the digit-employee/digit-citizen themes.
# Without DIGIT_LOCALIZATION_SEARCH_URL it falls back to DIGIT_GATEWAY_HOST
# (default http://gateway:8080), and a failed lookup silently serves no strings.
DIGIT_LOCALIZATION_SEARCH_URL=http://kong:8000/localization/messages/v1/_search
IDENTITY_BRANDING_CACHE_SECONDS=300
IDENTITY_BRANDING_DEFAULT_LOCALE=en_IN
# MDMS module holding LoginConfig and PrivacyPolicy (digit-ui UICONFIG_MODULENAME).
DIGIT_UI_CONFIG_MODULE_NAME=commonMDMSConfig
# Footer images and link shown on the login screens.
DIGIT_FOOTER_URL=/digit-ui/brand/digit-footer.png
DIGIT_FOOTER_BW_URL=/digit-ui/brand/digit-footer-bw.png
DIGIT_HOME_URL=https://www.digit.org/
# Citizen DIGIT tokens (#2167): the BFF mints an egov-otp code internally and
# password-grants the BFF-managed CITIZEN account with it. Internal URL only,
# never through Kong (the response carries the OTP). Empty = citizen sign-in
# answers 503 at context selection.
DIGIT_OTP_CREATE_URL=http://egov-otp:8089/otp/v1/_create
# OTP identity egov-user validates a CITIZEN grant against: mobileNumber
# (UserService.validateOtp), taken from the verified session phone. userName is
# an override only; see docs/identity-bff.md.
DIGIT_CITIZEN_OTP_IDENTITY=mobileNumber
DIGIT_CITIZEN_ROLES=CITIZEN
# Citizen phone OTP sign-in (#2189). `phone_otp` is offered on the citizen
# client only when both the secret and the send URL are set. The secret keys
# the stored code hashes and the phone/IP references in keys and audit records.
IDENTITY_CITIZEN_OTP_SECRET=<generated independently>
NOTIFICATION_MESSAGE_SEND_URL=http://novu-bridge:8080/novu-adapter/v1/messages/_send
NOTIFICATION_OTP_EVENT_TYPE=IDENTITY_OTP
IDENTITY_CITIZEN_OTP_TTL_SECONDS=300
IDENTITY_CITIZEN_OTP_MAX_ATTEMPTS=5
IDENTITY_CITIZEN_OTP_RESEND_SECONDS=30
IDENTITY_CITIZEN_OTP_SEND_WINDOW_SECONDS=3600
IDENTITY_CITIZEN_OTP_PHONE_SEND_LIMIT=5
IDENTITY_CITIZEN_OTP_IP_SEND_LIMIT=20
IDENTITY_CITIZEN_OTP_LOCKOUT_FAILURES=10
IDENTITY_CITIZEN_OTP_LOCKOUT_SECONDS=3600
IDENTITY_AUDIT_STREAM_MAXLEN=100000
# Token revocation goes straight to egov-user: Kong RBAC uses the account's home tenant.
DIGIT_USER_LOGOUT_URL=http://egov-user:8107/user/_logout
# Dedicated DIGIT employee holding only ACCOUNT_ADMIN. Used solely to create,
# update and rotate BFF-managed accounts; never for business API calls.
DIGIT_ADMIN_USERNAME=<dedicated admin username>
DIGIT_ADMIN_PASSWORD=<dedicated admin password>
DIGIT_ADMIN_TENANT_ID=<state tenant, e.g. pg>
DIGIT_MANAGED_BASE_ROLES=EMPLOYEE
DIGIT_MANAGED_ROLE_ALLOWLIST=EMPLOYEE,GRO,PGR_LME,DGRO,CSR,SUPERVISOR,AUTO_ESCALATE,PGR_VIEWER,TICKET_REPORT_VIEWER,ACCOUNT_ADMIN,MDMS_ADMIN,LOC_ADMIN,SUPERUSER
DIGIT_ROLE_CLIENT_ID=digit-ui
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_PREFIX=digit-identity

# Optional onboarding worker (off unless true). PGR must share the worker token.
ONBOARDING_WORKER_ENABLED=false
PGR_ONBOARDING_WORKER_URL=http://pgr-services:8080/pgr-services
PGR_ONBOARDING_WORKER_TOKEN=<generated; shared with PGR only>
ONBOARDING_TENANT_ADMIN_GROUP=tenant-admins
ONBOARDING_TENANT_ADMIN_ROLES=TENANT_ADMIN,GRO,ACCOUNT_ADMIN,MDMS_ADMIN,LOC_ADMIN,SUPERUSER
# MDMS_ADMIN employee used only to create the minimal identity-ready root.
DIGIT_PROVISIONER_USERNAME=<dedicated provisioner username>
DIGIT_PROVISIONER_PASSWORD=<its password>
DIGIT_PROVISIONER_TENANT_ID=<state tenant, e.g. pg>
DIGIT_MDMS_CREATE_URL=http://kong:8000/mdms-v2/v2/_create
DIGIT_MDMS_V2_SEARCH_URL=http://kong:8000/mdms-v2/v2/_search
DIGIT_MDMS_SCHEMA_SEARCH_URL=http://kong:8000/mdms-v2/schema/v1/_search
DIGIT_MDMS_SCHEMA_CREATE_URL=http://kong:8000/mdms-v2/schema/v1/_create
DIGIT_FOUNDATION_SOURCE_TENANT=pg
DIGIT_ENC_GENERATE_KEY_URL=http://egov-enc-service:1234/egov-enc-service/crypto/v1/_generatekey
