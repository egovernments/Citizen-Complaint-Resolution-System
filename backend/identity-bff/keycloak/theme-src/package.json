{
  "name": "digit-keycloak-theme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build-keycloak-theme": "npm run build && keycloakify build",
    "tokens": "node scripts/generate-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "scripts/screenshots.sh",
    "screenshots:update": "scripts/screenshots.sh --update-snapshots",
    "lint": "tsc -b --pretty false",
    "smoke": "scripts/keycloak-smoke.sh"
  },
  "dependencies": {
    "keycloakify": "^11.16.0",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
