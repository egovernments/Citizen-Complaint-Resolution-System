# Copy to .env and fill in the values marked REQUIRED. .env is gitignored — never commit real credentials.

# == REQUIRED: credentials and identity ======================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid          # Twilio console > Account SID
TWILIO_AUTH_TOKEN=your_twilio_auth_token            # Twilio console > Auth Token; also signs inbound webhooks
TWILIO_WEBHOOK_BASE_URL=                            # public base URL Twilio calls, no trailing path; falls back to EXTERNAL_HOST. Ex: https://mydomain.com
USER_SERVICE_ACCOUNT_USERNAME=                      # employee the bot acts as: provisions citizens, files their complaints
USER_SERVICE_ACCOUNT_PASSWORD=                      # no citizen ever logs in, so this account is privileged — keep it secret
USER_SERVICE_ACCOUNT_TENANT=mz                      # tenant the service account authenticates against
ROOT_TENANTID=pg                                    # tenant complaints are filed under

# == Access control ==========================================================
ALLOWED_MOBILE_NUMBERS=                             # comma-separated whitelist, no country code; empty = open to all in-country numbers
COUNTRY_CODE=91                                     # inbound numbers outside this prefix are dropped before any account is created
MOBILE_NUMBER_LENGTH=10                             # expected digits after the country code
TWILIO_VERIFY_WEBHOOK_SIGNATURE=true                # false makes inbound `From` attacker-controlled — local console testing only

# == Service =================================================================
NAME=xstate-chatbot
VERSION=0.0.1
SERVICE_PORT=8082
CONTEXT_PATH=/xstate-chatbot                        # inbound webhook is <CONTEXT_PATH>/message

# == Channel =================================================================
WHATSAPP_PROVIDER=Twilio                            # Twilio | Kaleyra | ValueFirst; anything else logs replies to stdout
WHATSAPP_BUSINESS_NUMBER=919880900990               # number citizens message
SERVICE_PROVIDER=eGov
TWILIO_WHATSAPP_NUMBER=+14155238886                 # Twilio's shared sandbox number, if not using an approved WABA number
TWILIO_BASE_URL=                                    # override the Messages API endpoint; empty = api.twilio.com
REPO_PROVIDER=InMemory                              # InMemory (sessions lost on restart) | Postgres (uses the DB_* block)

# == Locale ==================================================================
SUPPORTED_LOCALES=en_IN                             # comma-separated; the first is the default
DATEFORMAT=DD/MM/YYYY
TIMEZONE=Asia/Kolkata

# == Conversation ============================================================
CANCEL_WORDS=cancel,cancelar,cancele,stop,pare,para,parar       # abandon the session from any state
RESET_WORDS=reset,reiniciar,reinicie,restart,começar,comece,ola,oi,hello,reclamar   # restart from the menu
DESCRIPTION_MIN_LENGTH=20                           # shorter complaint descriptions are re-prompted
INSTITUTE_NAME_MAX_LENGTH=300
CASE_RELATED_TO=IGE
BOUNDARY_HIERARCHY_TYPE=divisao_administrativa      # which boundary-service hierarchy the location walk uses
COMPLAINT_SEARCH_LIMIT=3                            # complaints shown when a citizen asks for their list
MAX_MEDIA_SIZE_MB=5                                 # larger attachments are rejected with a retry prompt

# == Timing and concurrency ==================================================
AVG_SESSION_TIME=30                                 # minutes before a session counts as expired
REPLY_COOLDOWN_MS=2000                              # after a turn settles, ignore further messages for this long
DISPATCH_SETTLE_TIMEOUT_MS=30000                    # cap on holding a citizen's dispatch lock while a submission is in flight
MEDIA_PROCESSING_TIMEOUT_MS=13000                   # give up fetching an attachment from the provider
MAX_QUEUED_MESSAGES_PER_USER=3                      # messages allowed to wait behind the one in flight, per citizen

# == eGov service hosts ======================================================
EGOV_SERVICES_HOST=https://sandbox.digit.org/
EXTERNAL_HOST=https://sandbox.digit.org/            # public host, used for citizen-facing links
EGOV_SEARCHER_HOST=https://sandbox.digit.org/
USER_SERVICE_HOST=https://sandbox.digit.org/
LOCALIZATION_SERVICE_HOST=https://sandbox.digit.org/
# Path to the intermediate certificate for NODE_EXTRA_CA_CERTS
# NODE_EXTRA_CA_CERTS=/path/to/intermediate.pem — deliberately not committed.

# == eGov service paths (rarely changed) =====================================
USER_SERVICE_OAUTH_PATH=user/oauth/token
USER_SERVICE_CREATE_CITIZEN_PATH=user/citizen/_create
USER_SERVICE_UPDATE_PROFILE_PATH=user/profile/_update
USER_SERVICE_CITIZEN_DETAILS_PATH=user/_details
MDMS_SEARCH_PATH=egov-mdms-service/v1/_search
LOCALISATION_SERVICE_SEARCH_PATH=localization/messages/v1/_search
EGOV_FILESTORE_SERVICE_UPLOAD_ENDPOINT=filestore/v1/files?module=chatbot
EGOV_FILESTORE_SERVICE_DOWNLOAD_ENDPOINT=filestore/v1/files/url
PGR_CREATE_ENDPOINT=pgr-services/v2/request/_create
PGR_SEARCH_ENDPOINT=pgr-services/v2/request/_search
PGR_VERSION=v2

# == Citizen provisioning ====================================================
CITIZEN_PLACEHOLDER_NAME=Cidadão                    # name at creation, treated as "not named yet" so onboarding still asks

# == Database (Postgres) =====================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres4
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# == Kafka (telemetry) =======================================================
KAFKA_BOOTSTRAP_SERVER=localhost:9092
CHATBOT_TELEMETRY_TOPIC=chatbot-telemetry-v2        # credentials are redacted before publishing
KAFKA_CONSUMER_ENABLED=false
KAFKA_CONSUMER_GROUP_ID=xstate-chatbot

# == Sandbox mode (multi-tenant onboarding by email; currently unreachable) ==
ENABLE_SANDBOX_MODE=false
TENANT_MANAGEMENT_HOST=https://sandbox.digit.org
SANDBOX_HOST=https://sandbox.digit.org

# == Legacy (read by code, not worth changing) ===============================
USER_SERVICE_HARDCODED_PASSWORD=123456              # pre-service-account citizen login path
USER_LOGIN_AUTHORIZATION_HEADER=Basic ZWdvdi11c2VyLWNsaWVudDo=
SYSTEM_USER_MOBILE=9999999999
MSG_ID=20170310130900
