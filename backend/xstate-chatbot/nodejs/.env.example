# Copy this file to .env and fill in the values marked REQUIRED.
# .env is gitignored - never commit real credentials.

# -- Service ----------------------------------------------------------------
NAME=xstate-chatbot
VERSION=0.0.1
SERVICE_PORT=8082
CONTEXT_PATH=/xstate-chatbot

# -- Channel provider --------------------------------------------------------
# One of: Twilio, Kaleyra, ValueFirst. Anything else falls back to Console
# (logs replies to stdout instead of sending them - useful for local testing).
WHATSAPP_PROVIDER=Twilio
WHATSAPP_BUSINESS_NUMBER=919880900990
SERVICE_PROVIDER=eGov
# Session store: InMemory (sessions lost on restart) or Postgres (uses the DB_* block below).
REPO_PROVIDER=InMemory

# -- Twilio ------------------------------------------------------------------
# REQUIRED: from the Twilio console (Account SID / Auth Token).
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Twilio's shared WhatsApp sandbox number, if you're using the sandbox
# rather than an approved WhatsApp Business number.
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_BASE_URL=

# -- Tenant / locale ----------------------------------------------------------
ROOT_TENANTID=pg
# comma-separated mobile numbers allowed past the welcome gate; empty = no restriction
ALLOWED_MOBILE_NUMBERS=
SUPPORTED_LOCALES=en_IN
COUNTRY_CODE=91
MOBILE_NUMBER_LENGTH=10

# -- PGR / onboarding content -------------------------------------------------
DESCRIPTION_MIN_LENGTH=20
INSTITUTE_NAME_MAX_LENGTH=300
CASE_RELATED_TO=IGE
# which of the tenant's boundary-service hierarchy types PGR should walk
BOUNDARY_HIERARCHY_TYPE=divisao_administrativa
DATEFORMAT=DD/MM/YYYY
TIMEZONE=Asia/Kolkata
MSG_ID=20170310130900
AVG_SESSION_TIME=30
REPLY_COOLDOWN_MS=2000
MEDIA_PROCESSING_TIMEOUT_MS=13000
MAX_MEDIA_SIZE_MB=5

CANCEL_WORDS=cancel,cancelar,cancele,stop,pare,para,parar
RESET_WORDS=reset,reiniciar,reinicie,restart,começar,comece,ola,oi,hello,reclamar

# -- Sandbox mode (multi-tenant onboarding by email, currently unreachable) --
ENABLE_SANDBOX_MODE=false
TENANT_MANAGEMENT_HOST=https://sandbox.digit.org
SANDBOX_HOST=https://sandbox.digit.org

# -- eGov backend services -----------------------------------------------------
EGOV_SERVICES_HOST=https://sandbox.digit.org/
EXTERNAL_HOST=https://sandbox.digit.org/
EGOV_SEARCHER_HOST=https://sandbox.digit.org/
USER_SERVICE_HOST=https://sandbox.digit.org/
USER_SERVICE_OAUTH_PATH=user/oauth/token
USER_SERVICE_CREATE_CITIZEN_PATH=user/citizen/_create
USER_SERVICE_UPDATE_PROFILE_PATH=user/profile/_update
USER_SERVICE_CITIZEN_DETAILS_PATH=user/_details
# Service account the chatbot acts as: it provisions citizens via
# _createnovalidate and files their complaints, so no citizen ever logs in.
USER_SERVICE_ACCOUNT_USERNAME=
USER_SERVICE_ACCOUNT_PASSWORD=
USER_SERVICE_ACCOUNT_TENANT=mz
# Set on created citizens to satisfy egov
CITIZEN_PLACEHOLDER_PASSWORD=Chatbot@2026
LOCALIZATION_SERVICE_HOST=https://sandbox.digit.org/
MDMS_SEARCH_PATH=egov-mdms-service/v1/_search
LOCALISATION_SERVICE_SEARCH_PATH=localization/messages/v1/_search
EGOV_FILESTORE_SERVICE_UPLOAD_ENDPOINT=filestore/v1/files?module=chatbot
EGOV_FILESTORE_SERVICE_DOWNLOAD_ENDPOINT=filestore/v1/files/url
PGR_CREATE_ENDPOINT=pgr-services/v2/request/_create
PGR_SEARCH_ENDPOINT=pgr-services/v2/request/_search

USER_SERVICE_HARDCODED_PASSWORD=123456
USER_LOGIN_AUTHORIZATION_HEADER=Basic ZWdvdi11c2VyLWNsaWVudDo=
SYSTEM_USER_MOBILE=9999999999

PGR_VERSION=v2
COMPLAINT_SEARCH_LIMIT=3

# -- Database (Postgres) -------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres4
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# -- Kafka (telemetry) ----------------------------------------------------------
KAFKA_BOOTSTRAP_SERVER=localhost:9092
CHATBOT_TELEMETRY_TOPIC=chatbot-telemetry-v2
KAFKA_CONSUMER_ENABLED=false
KAFKA_CONSUMER_GROUP_ID=xstate-chatbot
