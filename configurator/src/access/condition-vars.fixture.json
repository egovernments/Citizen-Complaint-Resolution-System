{
 "doc": "The condition variables both engines evaluate (configurator access screens, #1380): resource.complaint.status, resource.complaint.assignedToCaller, user.roles (roles counted for the complaint, R2). Each case: a condition, a document as PolicyInputBuilder.buildRowDoc builds it, and the expected answer. Read by PolicyInputBuilderConditionVarsTest (Java JsonLogic) and utility/rbac-opa/test/condition-vars.test.mjs (the JsonLogic->Rego translation OPA runs).",
 "conditions": {
  "assigned_to_them": { "==": [{ "var": "resource.complaint.assignedToCaller" }, true] },
  "open_only": { "in": [{ "var": "resource.complaint.status" }, ["PENDINGFORASSIGNMENT", "PENDINGATLME", "PENDINGFORREASSIGNMENT"]] },
  "filed_or_assigned": { "or": [{ "==": [{ "var": "user.uuid" }, { "var": "resource.complaint.accountId" }] }, { "==": [{ "var": "resource.complaint.assignedToCaller" }, true] }] },
  "per_role_normal_form": { "or": [
   { "==": [{ "var": "user.uuid" }, { "var": "resource.complaint.accountId" }] },
   { "and": [{ "in": ["SUBCOUNTY_GRO", { "var": "user.roles" }] }, { "in": [{ "var": "resource.complaint.boundary" }, { "var": "user.attributes.jurisdictions" }] }] },
   { "and": [{ "in": ["PGR_VIEWER", { "var": "user.roles" }] }, { "==": [{ "var": "user.attributes.tenantWide" }, true] }] }
  ] }
 },
 "docs": {
  "assigned_open": { "user": { "uuid": "e1", "type": "EMPLOYEE", "roles": ["GRO"], "attributes": { "tenantWide": false, "departments": ["WATER"], "jurisdictions": ["W1"] } },
                     "resource": { "complaint": { "accountId": "c1", "department": "WATER", "boundary": "W2", "status": "PENDINGATLME", "assignedToCaller": true } } },
  "not_assigned_closed": { "user": { "uuid": "e1", "type": "EMPLOYEE", "roles": ["GRO"], "attributes": { "tenantWide": false, "departments": ["WATER"], "jurisdictions": ["W1"] } },
                     "resource": { "complaint": { "accountId": "c1", "department": "WATER", "boundary": "W2", "status": "CLOSEDAFTERRESOLUTION", "assignedToCaller": false } } },
  "scgro_inside": { "user": { "uuid": "e2", "type": "EMPLOYEE", "roles": ["EMPLOYEE", "SUBCOUNTY_GRO"], "attributes": { "tenantWide": false, "departments": [], "jurisdictions": ["W1", "W2"] } },
                     "resource": { "complaint": { "accountId": "c1", "department": "WATER", "boundary": "W2", "status": "PENDINGFORASSIGNMENT", "assignedToCaller": false } } },
  "scgro_role_not_counted_here": { "user": { "uuid": "e2", "type": "EMPLOYEE", "roles": ["EMPLOYEE"], "attributes": { "tenantWide": false, "departments": [], "jurisdictions": ["W1", "W2"] } },
                     "resource": { "complaint": { "accountId": "c1", "department": "WATER", "boundary": "W2", "status": "PENDINGFORASSIGNMENT", "assignedToCaller": false } } },
  "viewer_tenant_wide": { "user": { "uuid": "e3", "type": "EMPLOYEE", "roles": ["PGR_VIEWER"], "attributes": { "tenantWide": true, "departments": [], "jurisdictions": [] } },
                     "resource": { "complaint": { "accountId": "c1", "department": "ROADS", "boundary": "W9", "status": "RESOLVED", "assignedToCaller": false } } },
  "citizen_own": { "user": { "uuid": "c1", "type": "CITIZEN", "roles": ["CITIZEN"], "attributes": { "tenantWide": false, "departments": [], "jurisdictions": [] } },
                     "resource": { "complaint": { "accountId": "c1", "department": "WATER", "boundary": "W2", "status": "RESOLVED", "assignedToCaller": false } } }
 },
 "expected": {
  "assigned_to_them": { "assigned_open": true, "not_assigned_closed": false, "scgro_inside": false, "citizen_own": false },
  "open_only": { "assigned_open": true, "not_assigned_closed": false, "scgro_inside": true, "viewer_tenant_wide": false },
  "filed_or_assigned": { "assigned_open": true, "not_assigned_closed": false, "citizen_own": true, "viewer_tenant_wide": false },
  "per_role_normal_form": { "scgro_inside": true, "scgro_role_not_counted_here": false, "viewer_tenant_wide": true, "citizen_own": true, "assigned_open": false }
 }
}
