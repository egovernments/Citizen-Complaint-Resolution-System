#!/bin/bash
# Kubernetes stand-in for the `docker exec` calls in configure-keycloak.sh.
#
# Under Compose the script runs on the host and execs kcadm.sh inside the
# keycloak container. The Helm realm-configure Job runs the script inside the
# Keycloak image itself, so "exec in the keycloak container" is a local exec;
# kcadm reaches the server over the Service (KEYCLOAK_KCADM_SERVER).
#
# Supports exactly the forms the script uses:
#   docker exec [-i] [-e NAME=VALUE]... CONTAINER COMMAND [ARG]...
# Anything else fails loudly rather than being guessed at.
set -euo pipefail

if [ "${1:-}" != exec ]; then
  printf 'docker shim: only "docker exec" is supported, got: %s\n' "${1:-<none>}" >&2
  exit 64
fi
shift
while [ $# -gt 0 ]; do
  case "$1" in
    -i) shift ;;
    -e)
      case "${2:-}" in
        *=*) export "$2" ;;
        *) printf 'docker shim: -e needs NAME=VALUE\n' >&2; exit 64 ;;
      esac
      shift 2 ;;
    -*) printf 'docker shim: unsupported option %s\n' "$1" >&2; exit 64 ;;
    *) break ;;
  esac
done
if [ $# -lt 2 ]; then
  printf 'docker shim: expected CONTAINER COMMAND\n' >&2
  exit 64
fi
shift # the container name: there is only the one, this pod's own image
exec "$@"
