# Real per-deployment values (contains the DB password) — never commit.
terraform.tfvars

# Local Terraform state and working dir (state lives in the S3 backend).
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# An environment's DB password (environments/<env>.secret.tfvars), shared out of
# band, and the remote-state stack's per-environment backend, copied in from
# environments/ before `terraform init`.
*.secret.tfvars
remote-state/backend_override.tf
