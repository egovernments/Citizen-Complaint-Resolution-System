# Copy to terraform.tfvars (auto-loaded by terraform, and gitignored so the DB
# password stays out of the repo), then set the four values below. Everything
# else in variables.tf has a sensible default.
#
# The state bucket is set separately, in main.tf's backend block — a backend
# can't read tfvars. See DEPLOYMENT.MD.

# A name for your Kubernetes cluster.
cluster_name = "mycity"

# The application database name. No hyphens or special characters.
db_name = "ccrsdb"

# The database admin username.
db_username = "ccrs"

# The database password. Keep this file (terraform.tfvars) out of git.
db_password = "change-me-to-a-strong-password"
