# Copy this file to terraform.tfvars and fill in your values:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is loaded automatically by `terraform plan`/`apply` and is
# gitignored, so your database password never lands in the repo. These are the
# only per-deployment values you must set here; everything else in variables.tf
# has a sensible default.
#
# NOTE: the Terraform state bucket is NOT set here — a backend block cannot read
# tfvars. Edit that name directly in main.tf's `backend "s3"` block (create the
# bucket first with the ./remote-state helper). See DEPLOYMENT.MD.

# A name for your Kubernetes cluster.
cluster_name = "mycity"

# The application database name. No hyphens or special characters.
db_name = "ccrsdb"

# The database admin username.
db_username = "ccrs"

# The database password. Keep this file (terraform.tfvars) out of git.
db_password = "change-me-to-a-strong-password"
