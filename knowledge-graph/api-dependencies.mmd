%% CCRS / CMS v2.20 — pgr-services API dependency graph (request → controller → service → data / events / external)
%% All paths are under context /pgr-services. Package root: backend/pgr-services/src/main/java/org/egov/pgr/
%% 30 endpoints in 6 controllers; the onboarding/workspace/analytics groups are collapsed to one node per controller group.
%% Solid = CONFIRMED, dotted = INFERRED.
flowchart LR

  subgraph API["REST endpoints"]
    direction TB
    A1["POST /v2/request/_create"]
    A2["POST /v2/request/_update"]
    A3["POST /v2/request/_search"]
    A4["POST /v2/request/_count"]
    A5["POST /v2/request/_plainsearch<br/>(no record scoping)"]
    A6["POST /v2/request/inbox/_search · _count"]
    A7["GET /v2/dashboard<br/>(no RequestInfo, Cache-Control public)"]
    A8["POST /v2/employee/_context"]
    A9["POST /v2/analytics/* (10)<br/>incl. 4 anonymous public/*"]
    A10["POST /v2/onboarding/* (7)<br/>signups, identifiers, operations"]
    A11["POST /v2/onboarding/workspaces/* (3)"]
    A12["POST /migration/_transform<br/>(migration.enabled=false)"]
  end

  subgraph CTRL["Controllers (web/controllers, analytics, onboarding)"]
    direction TB
    RC["RequestsApiController"]
    EC["EmployeeContextController"]
    AC["AnalyticsController"]
    OC["OnboardingApiController"]
    WC["WorkspaceApiController"]
    MC["MigrationController"]
  end

  subgraph SVC["Services"]
    direction TB
    PS["PGRService<br/>create · update · search · count · plainSearch"]
    VAL["ServiceRequestValidator"]
    ENR["EnrichmentService"]
    US["UserService"]
    WS["WorkflowService"]
    ESC["EscalationService +<br/>EscalationLockManager"]
    SAP["SearchAccessPolicyService +<br/>PolicyDrivenScopeResolver"]
    FV["FieldVisibilityService"]
    EDS["EncryptionDecryptionService"]
    VS["VisibilityService"]
    DS["DashboardService"]
    ECS["EmployeeContextService"]
    AS["AnalyticsService +<br/>AnalyticsCapabilityService"]
    OS["OnboardingService +<br/>OnboardingRunner / OnboardingSteps"]
    WSS["WorkspaceService +<br/>WorkspaceGateway"]
    MS["MigrationService"]
    PR["Producer#push"]
  end

  subgraph REPO["Repositories / SQL"]
    direction TB
    PGRR["PGRRepository + PGRQueryBuilder"]
    DR["DashboardRepository"]
    HPR["HrmsProjectionRepository"]
    OR["OnboardingRepository /<br/>WorkspaceRepository"]
    SRR["ServiceRequestRepository<br/>(generic HTTP, null on non-4xx)"]
    IGR["IdGenRepository (HTTP)"]
  end

  subgraph DB["Tables / views"]
    direction TB
    T1[("eg_pgr_service_v2")]
    T2[("eg_pgr_address_v2")]
    T3[("eg_pgr_document_v2")]
    T4[("pgr_mv_* · complaint_facts ·<br/>complaint_events · complaint_open_state_daily")]
    T5[("eg_pgr_hrms_projection")]
    T6[("eg_pgr_onboarding_*")]
  end

  subgraph KAFKA["Kafka topics published"]
    K1{{"save-pgr-request"}}
    K2{{"update-pgr-request"}}
    K3{{"inbox-pgr-events"}}
    K4{{"pgr-escalation-events"}}
    K5{{"save-pgr-request-batch ·<br/>save-wf-transitions-batch"}}
  end

  subgraph EXTSVC["Outbound HTTP (DIGIT + CMS)"]
    direction TB
    X1["egov-workflow-v2<br/>process/_transition · process/_search ·<br/>businessservice/_search"]
    X2["mdms /egov-mdms-service/v1/_search"]
    X3["egov-user /user/_search ·<br/>users/_createnovalidate · _details"]
    X4["boundary-service boundary/_search ·<br/>boundary-relationships/_search"]
    X5["egov-hrms /employees/_search"]
    X6["egov-idgen /id/_generate"]
    X7["egov-enc-service crypto/v1/*"]
    X8["egov-accesscontrol<br/>/access/v1/actions/mdms/_get"]
    X9["identity-bff /internal/identity/v1/*"]
    X10["novu-bridge /novu-adapter/v1/tenants/*"]
    X11["egov-localization (onboarding)"]
  end

