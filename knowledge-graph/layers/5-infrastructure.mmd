    DO["monitoring · matomo · opensre · fast-path ·<br/>per-tenant overlays"]
    AN["ansible deploy.sh → playbook-deploy.yml<br/>host_vars/&lt;tenant&gt;.yml"]
  end

  subgraph K8S["Helm (devops/deploy-as-code)"]
    direction TB
    HF["digit-helmfile.yaml → backbone · core · common ·<br/>identity · urban · analytics · auxiliary · monitoring"]
    HC["charts/common library chart"]
    HCM["configmaps: egov-config, egov-service-host<br/><small>infra:configmap:egov-service-host</small>"]
