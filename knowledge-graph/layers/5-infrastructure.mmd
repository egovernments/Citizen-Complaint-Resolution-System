    LCI["local-setup-ci.yaml<br/>(runs docker-compose.yml, not the Ansible stack)"]
    NOJ["No PR workflow runs mvn test"]
  end

  subgraph COMPOSE["Docker Compose + Ansible"]
    direction TB
    DC["docker-compose.egov-digit.yaml (55 services)<br/><small>infra:compose:pgr-services …</small>"]
