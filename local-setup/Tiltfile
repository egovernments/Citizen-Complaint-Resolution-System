# DIGIT Core Services - Tiltfile
# Run with: tilt up

# Allow any k8s context since we're using docker-compose, not k8s
allow_k8s_contexts(k8s_context())

# Load extensions
load('ext://uibutton', 'cmd_button', 'location')
# Note: restart_process extension removed - not compatible with docker-compose

# ==================== Configuration ====================
# Path to CCRS code (for live UI and PGR development)
CCRS_PATH = os.getenv('CCRS_PATH', '..')

# The UI docker-compose.yml actually runs (egovio/digit-ui-esbuild). frontend/micro-ui is the
# legacy webpack app: building it here swapped a different UI in under Tilt.
UI_PATH = CCRS_PATH + '/digit-ui-esbuild'
PGR_PATH = CCRS_PATH + '/backend/pgr-services'

# Detect CI mode - use full Docker builds without live reload
# GitHub Actions sets CI=true, or manually set TILT_CI=1 for CI-style builds
CI_MODE = os.getenv('CI', '') != '' or os.getenv('TILT_CI', '') != ''

# ==================== PGR Services ====================
if CI_MODE:
    # CI Mode: run the registry images pinned in docker-compose.yml as-is. docker-compose.tilt.yml
    # is not loaded (see docker_compose() below), so there is no second copy of the image tags
    # here to drift from the compose pins.
    pass
else:
    # Local Dev Mode: Compile Java locally, then sync to container for fast hot reload
    # Requires: mvn and unzip installed locally
    for tool in ['mvn', 'unzip']:
        if 'not_found' in str(local('which ' + tool + ' || echo "not_found"', quiet=True)):
            fail('''
''' + tool + ''' not found! Local development with PGR hot reload needs Maven (JDK 17 or 21) and unzip:
  - macOS: brew install maven
  - Ubuntu: sudo apt install maven unzip

Or run without hot reload (pre-built images only):
  tilt up -f Tiltfile.db-dump
''')

    # Initial Maven build if target/extracted doesn't exist yet
    # This ensures the docker build context exists on first run
    pgr_target_exists = str(local('test -d "' + PGR_PATH + '/target/extracted" && echo "exists" || echo "missing"', quiet=True))
    if 'missing' in pgr_target_exists:
        print('PGR target not found, running initial Maven build...')
        local('cd ' + PGR_PATH + ' && mvn package -DskipTests -q && unzip -o target/pgr-services-*.jar -d target/extracted')
        print('PGR initial build completed')

    local_resource(
        'pgr-compile',
        'cd ' + PGR_PATH + ' && mvn package -DskipTests -q && ' +
        'unzip -o target/pgr-services-*.jar -d target/extracted',
        deps=[PGR_PATH + '/src', PGR_PATH + '/pom.xml'],
        labels=['pgr'],
    )

    docker_build(
        'pgr-services-dev',
        context=PGR_PATH + '/target/extracted',
        # sh -c so JAVA_OPTS from docker-compose.yml (-Xmx256m) applies, as it does for the
        # registry image's start.sh. A bare `java` ENTRYPOINT ignored it and sized the heap
        # off the container limit instead.
        dockerfile_contents='''
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
COPY . /app
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -cp .:BOOT-INF/lib/*:BOOT-INF/classes org.egov.pgr.PGRApp"]
''',
        live_update=[
            # The whole tree: `unzip -o` in pgr-compile rewrites every file, including the Spring
            # Boot loader under org/. A file outside every sync makes Tilt abandon the live update
            # ("Found file(s) not matching any sync") and rebuild the image instead.
            sync(PGR_PATH + '/target/extracted', '/app'),
            restart_container(),
        ],
    )

# ==================== DIGIT UI ====================
# The digit-ui container always runs the pinned registry image (:18080, behind Kong on :18000).
# For UI work, start 'ui-dev': the repo's esbuild dev server with live reload, on :18180. It
# proxies API calls to Kong on :18000 and serves the same globalConfigs.js as the container.
if not CI_MODE:
    npm_check = str(local('which npm || echo "not_found"', quiet=True))
    if 'not_found' not in npm_check:
        local_resource(
            'ui-dev',
            serve_cmd='cd ' + UI_PATH + ' && ([ -d node_modules ] || npm install --legacy-peer-deps) && npm run dev',
            serve_env={
                'PORT': '18180',
                'PROXY_PORT': '18000',
                'GLOBAL_CONFIGS': os.path.abspath('./nginx/globalConfigs.js'),
            },
            labels=['frontend'],
            resource_deps=['kong'],
            auto_init=False,  # Don't auto-start, trigger manually or enable via Tilt UI
            links=[link('http://localhost:18180/digit-ui/employee', 'UI dev server (live reload)')],
        )

# Load docker-compose configuration
# Note: wait=True blocks until ALL containers are healthy, which is too slow
# Instead, rely on docker-compose depends_on with service_healthy conditions
#
# docker-compose.tilt.yml repoints pgr-services at the pgr-services-dev image built above.
# Without it that docker_build binds to nothing and Tilt runs the registry image instead —
# silently, with no warning. See the comments in that file. CI mode builds nothing, so it
# runs docker-compose.yml alone.
if CI_MODE:
    docker_compose('./docker-compose.yml')
else:
    docker_compose(['./docker-compose.yml', './docker-compose.tilt.yml'])

