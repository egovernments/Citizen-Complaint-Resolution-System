# ═══════════════════════════════════════════════════════════════════
# bomet.yml.example — the EXACT host_vars that drove the validated
# 2026-06-11 local Bomet bring-up (see runbooks/03-bomet-onboarding.md
# and the Bomet replication kit docs).
#
# To use:
#   cp inventory/host_vars/bomet.yml.example inventory/host_vars/bomet.yml
#   # adjust domain/tls/secrets for non-local targets
#   ./deploy.sh bomet
#
# Secrets below are LOCAL TEST VALUES on purpose — replace every one of
# them for any reachable/real deployment (see kit GAPS-AND-DECISIONS).
# ═══════════════════════════════════════════════════════════════════

# Bomet replication — LOCAL adaptation of /home/user/Documents/CCRS/Bomet/host_vars/bomet.example.yml
# (the "Bomet replication kit", snapshot 2026-06-09, CCRS develop @ 1e28bfb7).
#
# Deploy:  cd local-setup/ansible && ./deploy.sh bomet
#
# DEVIATIONS FROM THE KIT (all forced by running on this laptop instead of
# the real bometfeedbackhub.digit.org box — see kit docs/GAPS-AND-DECISIONS.md):
#   domain/tls            kit: bometfeedbackhub.digit.org + TLS; here: localhost, plain HTTP
#   nginx_preserve_vhost  kit: true (hand-managed live vhost); here: false (no such vhost locally)
#   enable_mcp/build_mcp  kit: false (real Bomet's restored DB already contains ke);
#                         here: true — this box's DB has only pg+mz, so the MCP
#                         /v1/tenant/bootstrap shim is REQUIRED to create ke/ke MDMS,
#                         keys and ADMIN (exactly how mz was bootstrapped on this box)
#   deploy_become         kit: false; here: true (apt/nginx need root locally)
#   keycloak_google_*     kit: CHANGE_ME; here: blank → Google IdP wiring skipped
#   secrets               kit: CHANGE_ME (OpenBao-backed prod values); here: local test values
#
# Previous tenancy on this box (mz/Maputo) is backed up at
# inventory/host_vars/_maputo.yml.bak — postgres volume persists, so pg+mz
# data remains in the DB underneath the new ke layer.

# ── target box ──
ansible_host: localhost
ansible_connection: local
deploy_become: true
docker_default_platform: ''
domain: localhost
tls_enabled: false
docker_data_root: ""
insecure_registries: []


# ── identity / tenancy ──
# Kit shape was bare `ke` everywhere, but the configurator wizard created the
# city as `ke.bomet` and ALL wizard data lives there (BOMET-Hierarchy
# boundaries, 82 ServiceDefs, employees). The SPA must therefore land on
# ke.bomet — same split as the documented mz/mz.maputo pattern. JVM
# STATE_LEVEL pins (state_root/state_tenant_id/tenant_id) stay `ke`.
state_root: mz
state_tenant_id: mz
boot_tenant: mz
tenant_id: mz
ui_state_tenant_id: mz
nginx_preserve_vhost: false        # kit: true — local box has no hand-managed vhost to preserve
login_tenant_allowlist: ['mz']

# ── geography / boundary model (Bomet County) ──
map_center: { lat: -0.7817, lng: 35.3428 }
pgr_boundary_highest_level: "Provincia"
pgr_boundary_lowest_level: "Municipio"
boundary_type: "Municipio"
hierarchy_type: "divisao_administrativa"


# ── Kenya mobile validation (drives common-masters.MobileNumberValidation) ──
# Length + allowed leading digits are derived from mobileNumberRegex (see
# filter_plugins/mobile.py) — no separate length/starting-character fields.
core_mobile_configs:
  countryCode: '+258'
  mobileNumberRegex: "^8[0-9]{8}$"

# ── feature toggles (exact Bomet shape, except MCP — see header) ──
asset_s3_bucket: pg-egov-assets
digit_ui_mode: container
enable_search_stack: false
enable_mcp: true                   # kit: false — needed locally to bootstrap ke (no ke in this DB)
build_mcp: true                    # kit: false — build digit-mcp:local like the mz bring-up did
enable_novu: true                  # config-driven notifications target: Novu
db_fast_path: true                 # REQUIRED — see kit NON-PERSISTED-STATE.md / DB section
# New in _example.yml: scripts/preflight.py refuses db_fast_path: true without this
# explicit ack (deploy.sh would fail preflight otherwise). Added alongside the existing
# db_fast_path: true above — confirm this box has no anonymous-volume postgres data worth
# keeping before relying on it.
db_fast_path_ack_data_wipe: true
build_otp_publisher: true          # not in kit: real Bomet box already has otp-publisher:local;
                                   # the notifications profile needs it, so build it here
build_default_data_handler: true
build_digit_ui: true
build_configurator: true
tolerate_bootstrap_failures: true  # bootstrap is partial-success tolerant (see kit GAPS)

# ── Config-driven notifications (design D1/D4/D6/D7/D8) ──
# Bomet is the FIRST tenant cut over. PGR reads PGR.NotificationRouting +
# PGR.NotificationTemplate from MDMS, renders + localizes per recipient, and
# emits one pre-rendered event per (recipient × channel); novu-bridge delivers.
# docker-compose.bomet.yml ALSO hard-sets PGR_NOTIFICATION_CONFIG_DRIVEN=true.
pgr_notification_config_driven: true
novu_bridge_channel: "sms,whatsapp,email"         # SMS-first; add WHATSAPP/EMAIL as config-only routing edits
# All four Novu URLs share one origin with the template's default paths, so
# novu_public_base_url alone sets api/ws/front consistently (see _example.yml).
novu_public_base_url: "https://cms-pilot.digit.org"
novu_node_env: "production" #default local
novu_bridge_workflow_id_whatsapp: "complaints-whats-app"
# Custom image pins (built+pushed to the VPC registry by CI). Replace <sha>
# with the actual CI tags once the Phase 1/2 images are built. Until then the
# build_* flags above produce local images.
# pgr_services_image:  "<vpc-registry>:5000/egovio/pgr-services:notif-config-<sha>"
# novu_bridge_image:   "<vpc-registry>:5000/egovio/novu-bridge:passthrough-<sha>"

# Novu bootstrap inputs — left empty: Novu stack comes up, operator signs up
# at /novu/ and pastes the API key here for a second deploy (kit RUNBOOK flow).
novu_api_key: ""
twilio_account_sid: ""
twilio_auth_token: ""
twilio_whatsapp_from: "whatsapp:+14155238886"

nginx_features:
  brand_assets: false
  configurator: true
  configurator_caching: false
  status: true
  api_pgr: false
  mcp: true                        # kit: false — paired with enable_mcp above
  keycloak: true
  digit_ui_v2: true
  integration_tests: false         # new in _example.yml — pair with enable_integration_tests below
  integration_tests_runner: false  # new in _example.yml — pair with enable_integration_tests_runner below

# ── auth (Keycloak) ──
enable_keycloak: false
# Must stay '' while enable_keycloak is false — 'keycloak' flips the SPA's
# auth adapter to OIDC and citizen/employee logins POST to /kc/realms/...,
# which has no upstream when the keycloak profile is off (observed:
# citizen OTP login failing on this box, 2026-06-11).
auth_provider: ""
keycloak_client_id: digit-ui
enable_digit_ui_v2: true
digit_ui_esbuild_branch: feat/keycloak-auth-adapter
# New in _example.yml — companion to digit_ui_v2_branch below (was previously unset,
# so the playbook default 'https://github.com/ChakshuGautam/Citizen-Complaint-Resolution-System.git'
# was already in effect; making it explicit here).
digit_ui_v2_repo: "https://github.com/ChakshuGautam/Citizen-Complaint-Resolution-System.git"
digit_ui_v2_branch: feat/digit-ui-v2-keycloak
keycloak_google_client_id: ''      # kit: CHANGE_ME — blank skips Google IdP wiring

# ── secrets (LOCAL TEST VALUES — kit redacts these as CHANGE_ME) ──
secrets_path: kv/digit/bomet
bootstrap_secrets:
  postgres_password: egov123       # matches the role password already on this box's volume
  mcp_db_password: egov123
  minio_root_user: minioadmin
  minio_root_password: minioadmin  # matches the existing minio volume
  elasticsearch_master_password: "asd@#$@$!132123"  # MUST be this literal with db_fast_path
  egov_hrms_default_password: "eGov@123"            # Bomet uses eGov@123 (kit note)
  keycloak_admin_password: "eGov@123"
  keycloak_db_password: "eGov@123"
  keycloak_google_client_secret: ''
  token_exchange_system_password: "eGov@123"        # Bomet uses eGov@123 (kit note)

pgr_services_image:  "egovio/pgr-services:release-v2.12-moz-9deb7e0"
novu_bridge_image: "novu-bridge:local"  # manually built from source (OTP-via-Ozeki changes) — see backend/novu-bridge/Dockerfile
# ══════════════════════════════════════════════════════════════════════
# New parameters introduced by inventory/host_vars/_example.yml.
# None of these existed in this file before — every value/comment below is
# copied verbatim from the example template (its documented default), so
# nothing above this line was changed or overridden. Commented-out lines
# are copied in their commented (inactive) state, same as the example.
# Review each and move it up near its related section if you'd prefer a
# different layout — nothing here is position-sensitive.
# ══════════════════════════════════════════════════════════════════════

# Hide these modules in the employee UI. Common: ["IM"] to hide
# inbox-v2 if you're not running the search stack.
employee_module_denylist:
  - IM

# Postal-code validation. The SPA reads this via globalConfigs key
# CORE_POSTAL_CONFIGS for submit-time pattern checks in the citizen +
# employee PGR create-complaint flows. Empty/absent -> the legacy hard
# default (^[0-9]{5}$ / Kenya) is used as a fallback. Copied verbatim from
# the example's Kenya value — ADJUST for Mozambique postal codes before
# relying on it.
core_postal_configs:
  postalCodePattern: "^[0-9]{5}$"
  postalCodeLength: 5
  postalCodeErrorMessage: "CS_COMPLAINT_POSTALCODE_INVALID_ERROR"

# Postal-code serviceability allowlist. Leave UNSET (as here) to accept any
# postal code; do NOT set it to [] (mdms-v2 rejects empty arrays).
# pgr_pincode_allowlist:
#   - "00100"
#   - "00200"

# Footer logos shown in citizen + employee UI. Use absolute URLs; copied
# to /var/www/brand/ when nginx_features.brand_assets: true.
footer_logo_url: ""
footer_bw_logo_url: ""

# Optional (static mode only): serve a PREBUILT bundle image instead of
# cloning + building digit-ui-esbuild from git on the host. Leave unset to
# keep the legacy git-clone + on-host esbuild behavior (this tenant's
# current behavior, since digit_ui_mode: container above doesn't use this).
# digit_ui_bundle_image: "ghcr.io/subhashini-egov/digit-ui-esbuild:nightly-develop"

# digit-integration-tests dashboards (react-admin catalog + vanilla), served
# from /var/www. Off by default. Pair with
# nginx_features.integration_tests: true (already added above) to actually
# serve them.
enable_integration_tests: false
integration_tests_dashboard_base: "/tests-v2/"
integration_tests_basic_auth_user: "digit-tests"
# Set in vault (never commit a real password). The htpasswd task skips if unset.
# integration_tests_basic_auth_password: "{{ vault_integration_tests_password }}"

# RUN button: on-box test-runner daemon for the v2 dashboard. Requires
# enable_integration_tests: true AND
# nginx_features.integration_tests_runner: true (already added above). Off
# by default — a run is CPU/RAM heavy and shares the box with the live stack.
enable_integration_tests_runner: false
# integration_tests_runner_port: 8181        # loopback port the daemon listens on
# integration_tests_runner_run_limit: 5      # keep at most N runs on disk
# integration_tests_runner_branch: "deployed"
# integration_tests_runner_tenant_env: "/opt/integration-tests/deploy/bomet.env"

# Start the real OTP stack (egov-otp/user-otp/egov-notification-sms). Default
# false keeps the local kong.yml OTP mock (fixed OTP 123456, see
# CITIZEN_LOGIN_PASSWORD_OTP_FIXED_VALUE).
enable_otp_services: false

# Turbopass (OSM location autocomplete) — standalone on-box container
# powering the configurator's Phase 2 location autocomplete. Off by default:
# no image built, no container run, nginx vhost unchanged.
enable_turbopass: false
# turbopass_port: 13301        # loopback port the search-api publishes on

# Self-hosted Overpass (boundary-polygon fetch) for the configurator's Phase
# 2 OSM step. Off by default: falls back to the public overpass-api.de.
enable_overpass: false
# overpass_port: 12346                                   # loopback port
# overpass_data_dir: /opt/overpass/data                  # holds the extract (mounted /data)
# overpass_db_dir: /opt/overpass/db                      # Overpass DB volume (mounted /db)
# overpass_planet_file: /opt/overpass/data/boundaries.osm.bz2  # prepared extract

# Build a subpath-rebased Novu dashboard image locally so the SPA serves
# cleanly under /novu. Strongly recommended when Keycloak shares this
# domain (enable_keycloak is false here, so not required yet, but flip this
# on if enable_keycloak is ever turned on for this tenant). Off here — this
# tenant currently pulls the stock dashboard image.
build_novu_dashboard: false
# novu_dashboard_version: "2.3.0"   # upstream tag to rebase FROM
# novu_base_path: "/novu"           # subpath to bake into the rebased dist
# novu_dashboard_image: ""          # override to pin a prebuilt image instead of building

# Build the config-driven pgr-services / pass-through novu-bridge from source
# on the box, rather than pulling a published/preview image. Not currently
# referenced by playbook-deploy.yml (kept for forward-compat with the example
# template) — left at the example's default (false) either way.
build_novu_bridge: false
build_pgr_services: false

# Channels the bridge actually delivers + per-channel Novu workflow ids +
# subscriber-identify TTL cache — left at the example's defaults
# (SMS,EMAIL / complaints-sms|whatsapp|email / 300000ms).
novu_bridge_channels_enabled: "SMS,EMAIL,WHATSAPP"
# novu_bridge_workflow_id_sms:      "complaints-sms"
# novu_bridge_workflow_id_whatsapp: "complaints-whatsapp"
# novu_bridge_workflow_id_email:    "complaints-email"
# novu_bridge_identify_cache_ttl_ms: 300000

# Per-surface auth-provider override (citizen vs employee). Unset here —
# both surfaces inherit auth_provider / 'digit' as already set above.
# citizen_auth_provider: ""
# employee_auth_provider: ""

# Init the nairobi-mdms git submodule on the controller. Only needed if this
# tenant's onboarding uses those JSONs.
requires_nairobi_mdms: false

# Run the post-deploy CI suite (XLSX dataloader + Playwright). Off by
# default — production deploys skip CI tests.
run_ci_tests: false

# Install Claude Code CLI + sync controller's ~/.claude config to the
# target. Hard-codes /root/.claude paths; only safe when the controller is a
# Linux box running as root.
install_claude_code: false
