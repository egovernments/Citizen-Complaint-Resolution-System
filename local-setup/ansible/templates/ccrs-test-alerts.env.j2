# Integration-test regression email alerts — rendered by the playbook from the
# test_alerts_* host_vars (see inventory/host_vars/_example.yml). Read by
# ccrs-test-alerts.service through EnvironmentFile=, so this file stays
# root-only (0600) even though the poll itself runs unprivileged.
# Managed by Ansible: edit host_vars and redeploy; local edits are overwritten.
{#
  Every value is double-quoted with \ " $ ` escaped: systemd's env-file parser
  treats a backslash in an UNquoted value as an escape, which would silently
  change a password containing one.
#}
{% macro q(v) %}"{{ v | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"{% endmacro %}
ALERT_SMTP_URL={{ q(('smtps' if (test_alerts_smtp_tls | default(false) | bool) else 'smtp') ~ '://' ~ test_alerts_smtp_host ~ ':' ~ (test_alerts_smtp_port | default(587))) }}
ALERT_SMTP_STARTTLS={{ q((test_alerts_smtp_starttls | default(true) | bool) | lower) }}
{% if test_alerts_smtp_user | default('', true) %}
ALERT_SMTP_USER={{ q(test_alerts_smtp_user) }}
ALERT_SMTP_PASS={{ q(_test_alerts_smtp_pw) }}
{% endif %}
ALERT_FROM={{ q(test_alerts_from) }}
ALERT_TO={{ q(test_alerts_to | join(',')) }}
ALERT_BOX_NAME={{ q(test_alerts_box_name | default(inventory_hostname)) }}
ALERT_DASHBOARD_URL={{ q(test_alerts_dashboard_url | default('https://' ~ domain ~ '/tests/')) }}
ALERT_WEBROOT="/var/www/integration-tests"
ALERT_MAX_LIST={{ q(test_alerts_max_list | default(40)) }}
ALERT_STALE_AFTER_HOURS={{ q(test_alerts_stale_after_hours | default(0)) }}
