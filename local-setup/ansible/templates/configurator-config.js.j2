// Generated by ansible from inventory/host_vars/{{ inventory_hostname }}.yml
// + group_vars/digit.yml. Edit the inventory, not this file.
//
// Runtime deployment config for the configurator SPA, read at boot by:
//   <script src="/configurator/config.js"></script>
// in the bundle's index.html (see configurator/src/api/runtimeConfig.ts).
//
// This is what lets ONE pre-built image (egovio/configurator) serve every
// deployment. Before it existed these four values were baked in by `vite build`,
// so a correct configurator could only be produced by rebuilding on the target
// box — and a pulled image silently ran with all four empty.
//
// Precedence in the app: this file > build-time VITE_* > in-code default.
// A blank value here falls through rather than overriding with "".
window.__CONFIGURATOR_CONFIG__ = {
  // Root (state) tenant. Pre-fills the login form's tenant field — it is the
  // field's actual initial VALUE, not a placeholder. A city code like
  // "mz.maputo" collapses to its root segment "mz" in the app. Blank here falls
  // through to the SPA's default, 'pg' (the tenant the seed dump creates), so an
  // unconfigured deployment still points at a tenant that exists.
  STATE_TENANT_ID: {{ (state_tenant_id | default('')) | to_json }},

  // Overpass endpoint for the Phase-2 boundary-polygon fetch. Same-origin when
  // this box self-hosts Overpass (nginx /overpass/ -> the on-box container);
  // blank falls through to the public overpass-api.de, which is rate-limited
  // and 504-prone under real load.
  //
  // Deliberately NOT `enable_overpass` alone: the playbook skips the Overpass
  // container when the flag is on but the operator-prepared extract is absent,
  // and pointing the SPA at an nginx location that proxies to nothing (502) is
  // worse than the public fallback. `configurator_overpass_url` is set by the
  // playbook from the same extract check those tasks gate on — it is blank
  // whenever the local service was not actually provisioned.
  OVERPASS_URL: {{ (configurator_overpass_url | default('')) | to_json }},

  // Turbopass suggestions base (OSM place-name autocomplete). Same-origin
  // '/turbopass' when enable_turbopass is on; blank falls through to that
  // default anyway, so this is here for explicitness and overrides.
  TURBOPASS_URL: {{ (configurator_turbopass_url | default('')) | to_json }},

  // boundary-service page cap for the overview map. Must be a positive number;
  // blank / non-numeric / <= 0 => the app's 300 (a page size of 0 would fetch
  // nothing, so the app rejects it rather than render an empty map).
  BOUNDARY_SEARCH_LIMIT: {{ (configurator_boundary_search_limit | default('')) | string | to_json }},
};
