# Per-tenant Docker Compose .env — auto-loaded from the working directory.
# Generated by ansible from inventory/host_vars/{{ inventory_hostname }}.yml.
# Edit the inventory, not this file.
GF_SERVER_DOMAIN={{ domain }}
{# Scheme follows tls_enabled like the other URL keys below — a hardcoded
   https:// makes Grafana emit https redirects on a plain-HTTP tenant. (Vinoth review.) #}
GF_SERVER_ROOT_URL={{ 'https://' if (tls_enabled | default(true)) else 'http://' }}{{ domain }}/grafana/
{# Disable the fixed dev OTP (123456) wherever real OTP delivery is enabled, so
   the production OTP runbook is actually sufficient. (Vinoth review.) #}
CITIZEN_LOGIN_PASSWORD_OTP_FIXED_ENABLED={{ (not (enable_otp_services | default(false))) | lower }}
# Anonymous (logged-out) Grafana access. Off unless a tenant opts in with
# `grafana_anonymous_enabled: true`. Read the warning in _example.yml before
# flipping it: anonymous Viewers can read live bearer tokens out of Loki.
# This line is why the knob lives in host_vars and not in /opt/digit/.env —
# this file is regenerated on every deploy, so a hand-edit there is lost.
GF_ANONYMOUS_ENABLED={{ grafana_anonymous_enabled | default(false) | string | lower }}

# Publication addresses for compose `ports:` entries.
#
# BIND_IP covers everything and is ALWAYS loopback — Postgres, Redis, Redpanda,
# Elasticsearch, the Kong Admin API, the observability stack and OpenBao are
# never published off-host on any platform.
#
# PROXY_BIND_IP covers only the upstreams host nginx proxies. It differs solely
# on macOS, where the playbook runs nginx as a CONTAINER reaching the stack via
# host.docker.internal — that resolves to the host gateway, not 127.0.0.1, so a
# loopback-bound upstream would refuse it.
#
# Keeping these separate is the point: a single 0.0.0.0 on Darwin would also
# have exposed the secrets store and every datastore on the developer's LAN.
BIND_IP=127.0.0.1
PROXY_BIND_IP={{ '0.0.0.0' if ansible_system == 'Darwin' else '127.0.0.1' }}

# HRMS dev mode — lets employee-create set a caller-supplied password instead
# of an auto-generated one. Required by the configurator / XLSX onboarding
# wizards; off by default because it otherwise lets anyone who can create
# employees choose their credentials directly. See docker-compose.egov-digit.yaml.
EGOV_HRMS_DEV_MODE={{ hrms_dev_mode | default(false) | string | lower }}

# Elasticsearch (search profile only). xpack.security is ON, so the indexer and
# inbox authenticate. Sourced from bootstrap_secrets like every other credential.
ELASTICSEARCH_USERNAME={{ elasticsearch_username | default('elastic') }}
# ELASTICSEARCH_PASSWORD is NOT written here. Like every other secret it is
# written once, from OpenBao, by the "OpenBao — write secrets into compose .env"
# block in playbook-deploy.yml. Writing it here too produced a duplicate key in
# .env (last-wins), so whichever source was empty silently governed. Distinct
# from elasticsearch_master_password (egov-enc-service's PII master; NEVER reuse
# it as the ES login).

# MCP image. Resolved by the "Resolve MCP image tag" task: a local-only tag
# (digit-mcp:local) when build_mcp:true (deploy builds it itself, no registry
# pull needed), else left empty so Compose's own `${MCP_IMAGE:-default}`
# fallback — the source of truth for the pulled tag — takes over. Override
# with `mcp_image:` in host_vars.
MCP_IMAGE={{ mcp_image }}

# The notification stack's build. pgr-services, pgr-services-db, novu-bridge and
# novu-bridge-db default to egovio/<image>:${NOTIFICATION_STACK_TAG} in the compose
# files, so this one value moves all four together — they MUST come from the same
# build (see `notification_stack_tag` in host_vars/_example.yml). Left empty when
# unset: Compose's `${NOTIFICATION_STACK_TAG:-nightly-develop}` fallback treats an
# empty value as unset, so the compose file stays the single source of the default.
NOTIFICATION_STACK_TAG={{ notification_stack_tag | default('') }}

# pgr-services image override (one image only — the three others still follow
# NOTIFICATION_STACK_TAG). Pin it via `pgr_services_image:` in host_vars. Left empty
# when unset: Compose's own `${PGR_SERVICES_IMAGE:-default}` fallback treats an
# empty env value the same as unset, so the compose file stays the single source of
# truth for the default tag instead of it being duplicated (and drifting) here too.
PGR_SERVICES_IMAGE={{ pgr_services_image | default('') }}
PGR_SERVICES_DB_IMAGE={{ pgr_services_db_image | default('') }}

# Organization-aware identity images. Both are built from this repository;
# identity-keycloak pins Keycloak 26.7.3 plus the magic-link provider.
IDENTITY_BFF_IMAGE={{ identity_bff_image | default('') }}
IDENTITY_KEYCLOAK_IMAGE={{ identity_keycloak_image | default('') }}

# egov-accesscontrol image override — pin it via `accesscontrol_image:` in host_vars
# (e.g. a local ABAC-testing build). Default keeps the pinned upstream image.
ACCESSCONTROL_IMAGE={{ accesscontrol_image | default('egovio/egov-accesscontrol:abac-changes-cb6a372') }}

# egov-user image. Pinned to the 1044-preview build (tenant-aware encryption fix,
# CCRS#771 SafeHtmlValidator fix). INTENTIONAL EXCEPTION: this tag exists only
# on the preview registry — no egovio Docker Hub equivalent has been pushed yet
# (tracked in #1552). Override via `egov_user_image:` in host_vars when the
# preview registry is unreachable — fall back to egovio/egov-user:2.12-87e13fe
# (Docker Hub; lacks tenant-aware encryption).
EGOV_USER_IMAGE={{ egov_user_image | default('egovio/egov-user:2.12-87e13fe') }}


# novu-bridge image and its Flyway migrator, one image each — normally left empty
# so both follow NOTIFICATION_STACK_TAG above. Pin via `novu_bridge_image:` /
# `novu_bridge_db_image:` in host_vars; the compose fallback is the source of truth.
NOVU_BRIDGE_IMAGE={{ novu_bridge_image | default('') }}
NOVU_BRIDGE_DB_IMAGE={{ novu_bridge_db_image | default('') }}

# digit-ui image. CI-built by the SPA Build Pipeline (multi-arch amd64+arm64).
# Pin via `digit_ui_image:` in host_vars (e.g. the legacy micro-ui
# egovio/digit-ui:pgr-fixes, or a nightly) and set build_digit_ui:false so the
# deploy PULLS it instead of rebuilding. Left empty when unset — see the
# PGR_SERVICES_IMAGE comment above; the compose fallback is the source of truth.
DIGIT_UI_IMAGE={{ digit_ui_image | default('') }}

# configurator image. CI-built by the SPA Build Pipeline (multi-arch), served
# by the `configurator` compose service and proxied at /configurator/ by host
# nginx when build_configurator is false. Pin via `configurator_image:` in
# host_vars. Left empty when unset — see the PGR_SERVICES_IMAGE comment above;
# the compose fallback is the source of truth.
CONFIGURATOR_IMAGE={{ configurator_image | default('') }}

# JVM flags appended to every service's JAVA_TOOL_OPTIONS, gated on target OS.
# Darwin (Apple-Silicon Mac under Rosetta amd64): the C2 JIT compiler SIGBUSes
# (CompileBroker::collect_statistics) and CDS mmap'd archives also SIGBUS — so
# force C1-only JIT + disable CDS. Linux targets get an empty string -> zero
# production impact (Bomet / naipepea unaffected).
MAC_JVM_OPTS={{ '-XX:TieredStopAtLevel=1 -Xshare:off' if ansible_system == 'Darwin' else '' }}

{% if enable_novu | default(false) %}
# Novu dashboard SPA runs in the operator's browser — it can't reach
# `localhost:14002` because that would mean the operator's laptop.
# It must use the origin the BROWSER reaches, proxied through the host
# nginx /novu-api/ and /novu-ws/ locations (defined in nginx-site.conf.j2
# under the same enable_novu flag). Single-origin keeps cookies / CORS clean.
#
# That origin defaults to this tenant's own `domain`, which is right whenever
# the ansible-managed vhost is the one the browser hits. Override
# `novu_public_base_url` (scheme + host, no trailing slash) when TLS
# terminates on a vhost whose hostname differs from `domain` — e.g. an
# internal `domain: localhost` fronted by a separately-managed public vhost.
# The /novu-api, /novu-ws and /novu paths stay owned by this template because
# they must match the nginx location blocks; the per-URL overrides below are
# an escape hatch for the rare split-host case, not the normal knob.
{% set novu_public_origin = novu_public_base_url | default(('https://' if (tls_enabled | default(true)) else 'http://') + domain) %}
NOVU_NODE_ENV={{ novu_node_env | default('production') }}
NOVU_API_PUBLIC_URL={{ novu_api_public_url | default(novu_public_origin + '/novu-api') }}
# Socket.IO uses the URL origin and its fixed /socket.io transport path. A
# /novu-ws suffix here is discarded by the Novu 2.3.0 dashboard client.
NOVU_WS_PUBLIC_URL={{ novu_ws_public_url | default(novu_public_origin) }}
NOVU_API_ROOT_URL={{ novu_api_root_url | default(novu_public_origin + '/novu-api') }}
NOVU_FRONT_BASE_URL={{ novu_front_base_url | default(novu_public_origin + '/novu') }}
# Dashboard image: locally-built subpath-rebased image when
# `build_novu_dashboard: true` (tag novu-dashboard:local), else stock registry.
# Resolved by the "Resolve novu-dashboard image tag" set_fact in the playbook.
NOVU_DASHBOARD_IMAGE={{ novu_dashboard_image }}

# Self-hosted Novu's public signup. MUST stay true on any reachable deployment:
# false lets anyone who can reach /novu-api/v1/auth/register create an account in
# the notification console. The compose default is already true, but it was never
# written here, so the value was invisible to operators and impossible to flip for
# the one moment it legitimately has to be false.
#
# That moment is the FIRST deploy against an empty Mongo: Novu mints its first
# environment API key only as a side effect of the first signup, and
# `POST /v1/auth/register` answers 400 "Account creation is disabled" while this is
# true — so the "novu-bootstrap — mint Development API key" task could never
# succeed on a fresh box (it only ever worked on deployments that pin
# `novu_api_key`). The playbook opens a registration window around that single
# call and closes it again in an `always:` block; this line is what it flips, and
# re-rendering this template restores the secure value on every subsequent deploy.
# Do not set `novu_disable_user_registration: false` in host_vars to work around a
# failed mint — fix the mint.
NOVU_DISABLE_USER_REGISTRATION={{ novu_disable_user_registration | default(true) | string | lower }}

# Channels the bridge actually delivers. Add WHATSAPP only after a
# legitimate provider is configured as a Novu integration.
NOVU_BRIDGE_CHANNELS_ENABLED={{ novu_bridge_channels_enabled | default('') }}

# Roles allowed through the /novu-adapter proxy (ProxyAuthFilter). Include
# MDMS_ADMIN so the configurator's provider/template screens are not 403'd.
NOVU_BRIDGE_PROXY_ALLOWED_ROLES={{ novu_bridge_proxy_allowed_roles | default('EMPLOYEE,SUPERUSER,GRO,PGR_LME,MDMS_ADMIN') }}
# Managing providers (create / rotate credentials / delete) needs one of these instead —
# a role on the list above alone gets 403 NB_ADMIN_ROLE_REQUIRED on those three calls.
NOVU_BRIDGE_PROXY_ADMIN_ROLES={{ novu_bridge_proxy_admin_roles | default('SUPERUSER,MDMS_ADMIN,ACCOUNT_ADMIN') }}

# ── novu-bridge pass-through (design D4/D6) ──
# Per-channel Novu workflow ids (rendered text travels in payload.body).
NOVU_BRIDGE_WORKFLOW_ID_SMS={{ novu_bridge_workflow_id_sms | default('complaints-sms') }}
NOVU_BRIDGE_WORKFLOW_ID_WHATSAPP={{ novu_bridge_workflow_id_whatsapp | default('complaints-whatsapp') }}
NOVU_BRIDGE_WORKFLOW_ID_EMAIL={{ novu_bridge_workflow_id_email | default('complaints-email') }}
# Novu integration identifier to explicitly target for WHATSAPP triggers (a
# distinct, WhatsApp-registered Twilio integration). Twilio WhatsApp is an
# "sms"-channel step in Novu, so without this a WHATSAPP dispatch silently
# resolves to the PRIMARY sms integration (the plain SMS sender) instead.
# Leave unset until that dedicated integration is onboarded.
NOVU_BRIDGE_INTEGRATION_ID_WHATSAPP={{ novu_bridge_integration_id_whatsapp | default('') }}

# Ordinary SMS gateway. Blank (default) = SMS goes through Novu. "smscountry" =
# the SMS leg bypasses Novu and novu-bridge posts straight to SMSCountry's legacy
# bulk API. WhatsApp is unaffected either way.
NOVU_BRIDGE_SMS_PROVIDER={{ novu_bridge_sms_provider | default('') }}
NOVU_BRIDGE_SMS_SENDER_ID={{ novu_bridge_sms_sender_id | default('') }}
NOVU_BRIDGE_SMSCOUNTRY_URL={{ novu_bridge_smscountry_url | default('http://api.smscountry.com/SMSCwebservice_bulk.aspx') }}
NOVU_BRIDGE_SMSCOUNTRY_USER={{ novu_bridge_smscountry_user | default('') }}
NOVU_BRIDGE_SMSCOUNTRY_PASSWORD={{ novu_bridge_smscountry_password | default('') }}
NOVU_BRIDGE_IDENTIFY_CACHE_TTL_MS={{ novu_bridge_identify_cache_ttl_ms | default(300000) }}
# Hosts the SMSCountry adapter may post to (the SMSCOUNTRY_URL host is always
# allowed). Empty = the compose default (api.smscountry.com,www.smscountry.com).
NOVU_BRIDGE_SMSCOUNTRY_ALLOWED_HOSTS={{ novu_bridge_smscountry_allowed_hosts | default('') }}

# These four used to be hand-added to .env and were lost on the next deploy, which
# regenerates this file from scratch. Empty = the compose default.
# Delivery receipts shared secret (blank = receipts off).
NOVU_BRIDGE_RECEIPTS_SECRET={{ novu_bridge_receipts_secret | default('') }}
# Consent gate (compose default false) and its outage behaviour (default true = allow).
NOVU_BRIDGE_PREFERENCE_ENABLED={{ (novu_bridge_preference_enabled | string | lower) if novu_bridge_preference_enabled is defined else '' }}
NOVU_BRIDGE_PREFERENCE_FAIL_OPEN={{ (novu_bridge_preference_fail_open | string | lower) if novu_bridge_preference_fail_open is defined else '' }}
# Country code prefixed to core-SMS (OTP) numbers that arrive without one.
NOVU_BRIDGE_CORE_SMS_COUNTRY_CODE={{ novu_bridge_core_sms_country_code | default('') }}
{% endif %}

# ── Observability level (#1657) ──
# Stops the OTEL javaagent exporting into components this level does not
# deploy. Without these, a `metrics`- or `logs`-level tenant would still ship
# spans to an absent Tempo, and the collector would log export failures on a
# loop.
#
# The compose files read these as ${OTEL_*_EXPORTER:-otlp}, so an unset value
# means "full stack" — a bare `docker compose up` outside Ansible is unchanged.
OTEL_TRACES_EXPORTER={{ 'otlp' if (observability_level | default('traces')) == 'traces' else 'none' }}
OTEL_METRICS_EXPORTER={{ 'otlp' if (observability_level | default('traces')) in ['metrics', 'logs', 'traces'] else 'none' }}

# ── Gatus profile toggles ──
# These MUST mirror `compose_profiles` (playbook-deploy.yml "Compute compose
# profiles for this tenant"): the same enable_* flag that starts an optional
# stack has to switch on that stack's Gatus checks, or a stack we deployed goes
# unmonitored and looks identical to one that was never deployed.
#
# COMPOSE_PROFILES gates which `profiles:`-tagged services start; GATUS_PROFILE_*
# gates which Gatus checks are enabled. Different variables, same source of truth
# — derive both from enable_*, and they can never drift apart.
#
# Rendered unconditionally: the compose files read these as ${GATUS_PROFILE_*:-false},
# and that fallback is what makes an unset toggle mean "off" rather than a red
# check for a stack this tenant does not run.
# Slack alerting for Gatus (#1609). Empty = OFF, which is the default: gatus
# treats an empty webhook-url as a misconfigured provider, warns once, and keeps
# serving the dashboard -- it does not fail to start. Set gatus_slack_webhook_url
# in host_vars (ideally sourced from OpenBao, since anyone holding the URL can
# post into the channel) to turn alerting on for a tenant. The channel is chosen
# by whoever mints the webhook; there is nothing else to configure.
GATUS_SLACK_WEBHOOK_URL={{ gatus_slack_webhook_url | default('') }}
# Watch the monitoring itself (#1613). The Ansible tier always deploys the full
# observability stack, so this is unconditionally true here. Once alerting is on
# (#1609), silence means "all clear" — and silence looks the same if Loki has
# crashed and Grafana has stopped evaluating rules.
GATUS_OBSERVABILITY={{ gatus_observability_checks | default(true) | lower }}
# Public TLS-certificate check (#1622). Every other Gatus check runs inside the
# container network and never presents the public certificate, so an expired one
# leaves the whole dashboard green while the site is unusable for everyone.
#
# Only meaningful when TLS actually terminates here, so it follows tls_enabled.
# Override gatus_tls_check in host_vars to force it off — e.g. where the gatus
# container cannot reach the public hostname from inside the host (hairpin NAT
# is not universal), which would otherwise show as a false failure.
GATUS_TLS={{ (gatus_tls_check | default(tls_enabled | default(true))) | lower }}
# Always populated, even when the check is disabled. Gatus validates `url` on
# EVERY endpoint regardless of `enabled:`, so an empty value here is not an inert
# placeholder -- it makes gatus PANIC at startup ("you must specify an url for
# each endpoint"), the container dies, and the whole health dashboard goes with
# it (nginx /status/ 502s). Caught deploying this to a tenant with
# tls_enabled: false.
#
# `enabled: ${GATUS_TLS}` is what actually gates the check. The URL only has to
# be syntactically present; it is never dialled while the endpoint is disabled.
GATUS_PUBLIC_URL={{ ('https://' if (tls_enabled | default(true)) else 'http://') + domain + '/' }}

GATUS_PROFILE_OTP={{ enable_otp_services | default(false) | lower }}
GATUS_PROFILE_SEARCH={{ enable_search_stack | default(false) | lower }}
GATUS_PROFILE_MCP={{ enable_mcp | default(false) | lower }}
GATUS_PROFILE_KEYCLOAK={{ enable_keycloak | default(false) | lower }}
GATUS_PROFILE_NOTIFICATIONS={{ enable_novu | default(false) | lower }}
GATUS_PROFILE_CHATBOT={{ enable_chatbot | default(false) | lower }}

# ── Inbound WhatsApp (xstate-chatbot) ──
# The inbound half of bidirectional WhatsApp. Novu/novu-bridge is outbound only and
# has no webhook receiver; this service is what Twilio calls when a citizen messages
# the business number. Gated by the `chatbot` compose profile (enable_chatbot).
# See docs/2.12/notifications/inbound-whatsapp.md.
CHATBOT_ROOT_TENANT={{ chatbot_root_tenant | default(state_root | default('pg')) }}
CHATBOT_SUPPORTED_LOCALES={{ chatbot_supported_locales | default('en_IN') }}
CHATBOT_WHATSAPP_PROVIDER={{ chatbot_whatsapp_provider | default('Twilio') }}
CHATBOT_WHATSAPP_BUSINESS_NUMBER={{ chatbot_whatsapp_business_number | default('') }}
CHATBOT_GEO_SEARCH={{ chatbot_geo_search | default(false) | lower }}
CHATBOT_BOUNDARY_HIERARCHY_TYPE={{ chatbot_boundary_hierarchy_type | default('ADMIN') }}
# Public origin Twilio was pointed at. Pinning it stops a forged Host header from
# steering signature validation at a URL the attacker controls.
CHATBOT_WEBHOOK_BASE_URL={{ chatbot_webhook_base_url | default((('https://' if (tls_enabled | default(true)) else 'http://') + domain) if domain is defined else '') }}
CHATBOT_VALIDATE_SIGNATURE={{ chatbot_validate_signature | default(true) | lower }}
CHATBOT_REMINDER_TOKEN={{ chatbot_reminder_token | default('') }}
CHATBOT_EXTERNAL_HOST={{ chatbot_external_host | default(((('https://' if (tls_enabled | default(true)) else 'http://') + domain + '/') if domain is defined else 'http://kong:8000/')) }}
{% if chatbot_image is defined and chatbot_image %}
XSTATE_CHATBOT_IMAGE={{ chatbot_image }}
{% endif %}
{% if chatbot_db_image is defined and chatbot_db_image %}
XSTATE_CHATBOT_DB_IMAGE={{ chatbot_db_image }}
{% endif %}

# Twilio credentials. Shared by the chatbot's inbound signature check and the Novu
# outbound bootstrap, so both halves authenticate against the same account.
TWILIO_ACCOUNT_SID={{ twilio_account_sid | default('') }}
TWILIO_AUTH_TOKEN={{ twilio_auth_token | default('') }}
TWILIO_WHATSAPP_FROM={{ twilio_whatsapp_from | default('') }}

# ── Bootstrap admin (host_vars bootstrap_user / bootstrap_password) ──
# user-seed reads these (as SEED_ADMIN_USER/SEED_ADMIN_PASSWORD) and creates
# this user with full admin roles on every seed tenant. Without this, a
# deploy that overrides bootstrap_user/bootstrap_password dies at the
# "validate — auth flow" task: the playbook mints its first token as this
# user, but nothing earlier ever created it (user-seed.sh used to hardcode
# ADMIN/eGov@123, and the playbook's own ensure-ADMIN task both runs later
# AND is gated `state_root != 'pg'`).
BOOTSTRAP_USER={{ bootstrap_user | default('ADMIN') }}
BOOTSTRAP_PASSWORD={{ bootstrap_password | default('eGov@123') }}

# Identity defaults are rendered unconditionally because Compose interpolates
# profile-gated services even when the Keycloak profile is off.
KEYCLOAK_ORGANIZATION_REALM={{ keycloak_organization_realm | default('digit') }}
IDENTITY_AUTH_METHODS={{ identity_auth_methods | default('[{"id":"password","label":"Email and password","type":"password"}]') }}
IDENTITY_DIGIT_ADMIN_USERNAME={{ identity_digit_admin_username | default(bootstrap_user | default('ADMIN')) }}
IDENTITY_DIGIT_ADMIN_TENANT_ID={{ identity_digit_admin_tenant_id | default(state_tenant_id) }}
IDENTITY_DIGIT_PROVISIONER_USERNAME={{ identity_digit_provisioner_username | default('') }}
IDENTITY_DIGIT_PROVISIONER_TENANT_ID={{ identity_digit_provisioner_tenant_id | default('') }}
IDENTITY_FOUNDATION_SOURCE_TENANT={{ identity_foundation_source_tenant | default('pg') }}
IDENTITY_ONBOARDING_WORKER_ENABLED={{ identity_onboarding_worker_enabled | default(false) | lower }}
IDENTITY_RECONCILE_ON_STARTUP={{ identity_reconcile_on_startup | default(true) | lower }}
IDENTITY_RECONCILIATION_INTERVAL_SECONDS={{ identity_reconciliation_interval_seconds | default(900) }}

{% if enable_keycloak | default(false) %}
# Keycloak + Identity BFF non-secret values. Secrets are appended from
# OpenBao later in the deploy.
KC_HOSTNAME={{ 'https://' + domain if (tls_enabled | default(true)) else 'http://' + domain }}/auth
KEYCLOAK_ISSUER={{ 'https://' + domain if (tls_enabled | default(true)) else 'http://' + domain }}/auth/realms/{{ keycloak_organization_realm | default('digit') }}
IDENTITY_REDIRECT_URI={{ 'https://' + domain if (tls_enabled | default(true)) else 'http://' + domain }}/identity/v1/callback
IDENTITY_POST_LOGIN_REDIRECT={{ identity_post_login_redirect | default(('https://' if (tls_enabled | default(true)) else 'http://') + domain + '/') }}
IDENTITY_ALLOWED_ORIGINS={{ identity_allowed_origins | default(('https://' if (tls_enabled | default(true)) else 'http://') + domain) }}
IDENTITY_COOKIE_SECURE={{ tls_enabled | default(true) | lower }}
IDENTITY_COOKIE_SAME_SITE=Lax
{% if (keycloak_google_client_id | default('')) | length > 0 %}
KC_GOOGLE_CLIENT_ID={{ keycloak_google_client_id }}
{% endif %}
{% endif %}

# ── Self-hosted Matomo (#1254) ──
# Rendered unconditionally: compose
# interpolates the WHOLE merged file before it starts anything, and
# docker-compose.matomo.yml is layered as an -f flag on every tenant whether or
# not the `matomo` profile is selected. Leaving these unset would print
# "variable is not set" warnings on every compose command on every box.
#
# MATOMO_PORT is a LOOPBACK bind (127.0.0.1:${MATOMO_PORT}:80) — the admin UI
# is not public. It must stay in step with upstream_matomo_port, which is also
# the Host header the nginx tracking blocks send and the origin Matomo's
# installer records in General.trusted_hosts — changing it after the installer
# has run leaves those two disagreeing.
MATOMO_PORT={{ upstream_matomo_port | default(18081) }}
# Seconds between console core:archive passes. Matomo computes reports
# separately from recording hits, so without archiving the dashboards read
# empty while data is demonstrably arriving. Hourly is Matomo's own
# recommendation for a site this size.
MATOMO_ARCHIVE_INTERVAL={{ matomo_archive_interval | default(3600) }}
# The matching MATOMO_DB_PASSWORD / MATOMO_DB_ROOT_PASSWORD are pulled from
# OpenBao later in the deploy and appended by a `lineinfile` task, so they are
# deliberately not rendered here.
