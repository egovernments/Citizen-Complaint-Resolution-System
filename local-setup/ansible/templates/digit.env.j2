# Per-tenant Docker Compose .env — auto-loaded from the working directory.
# Generated by ansible from inventory/host_vars/{{ inventory_hostname }}.yml.
# Edit the inventory, not this file.
GF_SERVER_DOMAIN={{ domain }}
GF_SERVER_ROOT_URL=https://{{ domain }}/grafana/

# MCP image. Resolved by the "Resolve MCP image tag" task: a local-only
# tag (digit-mcp:local) when build_mcp:true (deploy builds it itself, no
# registry), else {{ docker_registry }}/digit-mcp:latest. Override with
# `mcp_image:` in host_vars.
MCP_IMAGE={{ mcp_image }}

# pgr-services image. Canonical nightly form is <registry>/pgr-services:nightly-develop
# — pin it via `pgr_services_image:` in host_vars. Default is the multi-arch
# egovio Docker Hub build (matches the compose fallback; see
# build/NIGHTLY-BUILDS.md for the nightly channels).
PGR_SERVICES_IMAGE={{ pgr_services_image | default('egovio/pgr-services:master-8116812') }}

# egov-accesscontrol image override — pin it via `accesscontrol_image:` in host_vars
# (e.g. a local ABAC-testing build). Default keeps the pinned upstream image.
ACCESSCONTROL_IMAGE={{ accesscontrol_image | default('egovio/egov-accesscontrol:abac-changes-cb6a372') }}

# egov-user image. Pinned to the 1044-preview build (tenant-aware encryption fix,
# CCRS#771 SafeHtmlValidator fix). INTENTIONAL EXCEPTION: this tag exists only
# on the preview registry — no egovio Docker Hub equivalent has been pushed yet
# (tracked in #1552). Override via `egov_user_image:` in host_vars when the
# preview registry is unreachable — fall back to egovio/egov-user:2.12-87e13fe
# (Docker Hub; lacks tenant-aware encryption).
EGOV_USER_IMAGE={{ egov_user_image | default('egovio/egov-user:2.12-87e13fe') }}

# otp-publisher image. Local build (otp-publisher:local) when
# build_otp_publisher:true, else pin a registry build via `otp_publisher_image:`.
OTP_PUBLISHER_IMAGE={{ otp_publisher_image | default('otp-publisher:local') }}

# novu-bridge image. Pass-through build (PGR pre-renders + localizes; the
# bridge only identifies the Novu subscriber + delivers renderedBody).
# Pin via `novu_bridge_image:` in host_vars. Default is the multi-arch
# egovio Docker Hub build (matches the compose fallback).
NOVU_BRIDGE_IMAGE={{ novu_bridge_image | default('egovio/novu-bridge:master-8116812') }}

# digit-ui image. Default is the modern esbuild bundle image, CI-built by
# the SPA Build Pipeline (multi-arch amd64+arm64) and matching the compose
# fallback. Pin via `digit_ui_image:` in host_vars (e.g. the legacy
# micro-ui egovio/digit-ui:pgr-fixes, or a nightly) and set
# build_digit_ui:false so the deploy PULLS it instead of rebuilding.
DIGIT_UI_IMAGE={{ digit_ui_image | default('egovio/digit-ui-esbuild:master-cae07a3') }}

# configurator image. CI-built by the SPA Build Pipeline (multi-arch),
# served by the `configurator` compose service and proxied at
# /configurator/ by host nginx when build_configurator is false. Pin via
# `configurator_image:` in host_vars; default matches the compose fallback.
CONFIGURATOR_IMAGE={{ configurator_image | default('egovio/configurator:master-cae07a3') }}

# JVM flags appended to every service's JAVA_TOOL_OPTIONS, gated on target OS.
# Darwin (Apple-Silicon Mac under Rosetta amd64): the C2 JIT compiler SIGBUSes
# (CompileBroker::collect_statistics) and CDS mmap'd archives also SIGBUS — so
# force C1-only JIT + disable CDS. Linux targets get an empty string -> zero
# production impact (Bomet / naipepea unaffected).
MAC_JVM_OPTS={{ '-XX:TieredStopAtLevel=1 -Xshare:off' if ansible_system == 'Darwin' else '' }}

{% if enable_novu | default(false) %}
# Novu dashboard SPA runs in the operator's browser — it can't reach
# `localhost:14002` because that would mean the operator's laptop.
# It must use the origin the BROWSER reaches, proxied through the host
# nginx /novu-api/ and /novu-ws/ locations (defined in nginx-site.conf.j2
# under the same enable_novu flag). Single-origin keeps cookies / CORS clean.
#
# That origin defaults to this tenant's own `domain`, which is right whenever
# the ansible-managed vhost is the one the browser hits. Override
# `novu_public_base_url` (scheme + host, no trailing slash) when TLS
# terminates on a vhost whose hostname differs from `domain` — e.g. an
# internal `domain: localhost` fronted by a separately-managed public vhost.
# The /novu-api, /novu-ws and /novu paths stay owned by this template because
# they must match the nginx location blocks; the per-URL overrides below are
# an escape hatch for the rare split-host case, not the normal knob.
{% set novu_public_origin = novu_public_base_url | default(('https://' if (tls_enabled | default(true)) else 'http://') + domain) %}
NOVU_NODE_ENV={{ novu_node_env | default('production') }}
NOVU_API_PUBLIC_URL={{ novu_api_public_url | default(novu_public_origin + '/novu-api') }}
NOVU_WS_PUBLIC_URL={{ novu_ws_public_url | default(novu_public_origin + '/novu-ws') }}
NOVU_API_ROOT_URL={{ novu_api_root_url | default(novu_public_origin + '/novu-api') }}
NOVU_FRONT_BASE_URL={{ novu_front_base_url | default(novu_public_origin + '/novu') }}
# Dashboard image: locally-built subpath-rebased image when
# `build_novu_dashboard: true` (tag novu-dashboard:local), else stock registry.
# Resolved by the "Resolve novu-dashboard image tag" set_fact in the playbook.
NOVU_DASHBOARD_IMAGE={{ novu_dashboard_image }}

# Channels the bridge actually delivers. Add WHATSAPP only after a
# legitimate provider is configured as a Novu integration.
NOVU_BRIDGE_CHANNELS_ENABLED={{ novu_bridge_channels_enabled | default('SMS,EMAIL') }}

# Roles allowed through the /novu-adapter proxy (ProxyAuthFilter). Include
# MDMS_ADMIN so the configurator's provider/template screens are not 403'd.
NOVU_BRIDGE_PROXY_ALLOWED_ROLES={{ novu_bridge_proxy_allowed_roles | default('EMPLOYEE,SUPERUSER,GRO,PGR_LME') }}

# ── novu-bridge pass-through (design D4/D6) ──
# Per-channel Novu workflow ids (rendered text travels in payload.body).
NOVU_BRIDGE_WORKFLOW_ID_SMS={{ novu_bridge_workflow_id_sms | default('complaints-sms') }}
NOVU_BRIDGE_WORKFLOW_ID_WHATSAPP={{ novu_bridge_workflow_id_whatsapp | default('complaints-whatsapp') }}
NOVU_BRIDGE_WORKFLOW_ID_EMAIL={{ novu_bridge_workflow_id_email | default('complaints-email') }}
NOVU_BRIDGE_IDENTIFY_CACHE_TTL_MS={{ novu_bridge_identify_cache_ttl_ms | default(300000) }}
# Channel the bridge dispatches (sms|whatsapp|email). SMS-first per §3 phasing.
NOVU_BRIDGE_CHANNEL={{ novu_bridge_channel | default('sms') }}
{% endif %}

# ── Gatus profile toggles ──
# These MUST mirror `compose_profiles` (playbook-deploy.yml "Compute compose
# profiles for this tenant"): the same enable_* flag that starts an optional
# stack has to switch on that stack's Gatus checks, or a stack we deployed goes
# unmonitored and looks identical to one that was never deployed.
#
# COMPOSE_PROFILES gates which `profiles:`-tagged services start; GATUS_PROFILE_*
# gates which Gatus checks are enabled. Different variables, same source of truth
# — derive both from enable_*, and they can never drift apart.
#
# Rendered unconditionally: the compose files read these as ${GATUS_PROFILE_*:-false},
# and that fallback is what makes an unset toggle mean "off" rather than a red
# check for a stack this tenant does not run.
GATUS_PROFILE_OTP={{ enable_otp_services | default(false) | lower }}
GATUS_PROFILE_SEARCH={{ enable_search_stack | default(false) | lower }}
GATUS_PROFILE_MCP={{ enable_mcp | default(false) | lower }}
GATUS_PROFILE_KEYCLOAK={{ enable_keycloak | default(false) | lower }}
GATUS_PROFILE_NOTIFICATIONS={{ enable_novu | default(false) | lower }}

# ── PGR config-driven notifications flag (design D1/D8) ──
# Default false (legacy hardcoded path). Bomet sets pgr_notification_config_driven:
# true in host_vars; docker-compose.bomet.yml also hard-sets it for the tenant.
# Rendered unconditionally so the compose `${PGR_NOTIFICATION_CONFIG_DRIVEN}`
# placeholder always resolves (no "variable is not set" warning).
PGR_NOTIFICATION_CONFIG_DRIVEN={{ pgr_notification_config_driven | default(false) | lower }}

# token-exchange-svc references TOKEN_EXCHANGE_SYSTEM_TENANT regardless of
# whether the keycloak profile is active; set it unconditionally so Docker
# Compose does not emit "variable is not set" warnings on every `up`.
TOKEN_EXCHANGE_SYSTEM_USERNAME={{ token_exchange_system_username | default('ADMIN') }}
TOKEN_EXCHANGE_SYSTEM_USER_TYPE={{ token_exchange_system_user_type | default('EMPLOYEE') }}
TOKEN_EXCHANGE_SYSTEM_TENANT={{ state_tenant_id }}

{% if enable_keycloak | default(false) %}
# Keycloak + token-exchange-svc — non-secret values. The matching
# secrets (KC_ADMIN_PASSWORD, KC_DB_PASSWORD,
# TOKEN_EXCHANGE_SYSTEM_PASSWORD, KC_GOOGLE_CLIENT_SECRET) are pulled
# from OpenBao later in the deploy and appended to this .env via a
# `blockinfile` task, so they're not rendered here.
KC_HOSTNAME={{ 'https://' + domain if (tls_enabled | default(true)) else 'http://' + domain }}/auth
{% if (keycloak_google_client_id | default('')) | length > 0 %}
KC_GOOGLE_CLIENT_ID={{ keycloak_google_client_id }}
{% endif %}
{% endif %}
