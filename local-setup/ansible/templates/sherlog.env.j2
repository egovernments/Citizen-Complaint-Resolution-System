# Sherlog's settings for this tenant (docs/sherlog.md). The names are Sherlog's (.env.example in its bundle); only
# what CCRS sets is here, the rest are Sherlog's defaults. Mode 0600: it holds the model key and tokens.
SHERLOG_VERSION={{ sherlog_version }}
SHERLOG_IMAGE={{ sherlog_image }}
SHERLOG_RUNNER_IMAGE={{ sherlog_image }}-runner
SHERLOG_CONFIG=./sherlog.yaml
SHERLOG_OVERRIDE=./override.yaml
# The stack's network, Loki and Prometheus (compose project "{{ digit_dir | basename }}").
MONITORING_NETWORK={{ digit_dir | basename }}_egov-network
LOKI_URL=http://loki:3100
PROMETHEUS_URL=http://prometheus:9090
TEMPO_URL=http://tempo:3200
PACK_DIR=/packs/digit
ALERTMANAGER_CONFIG=./rendered/alertmanager.yml
MODE={{ sherlog_mode }}
DAILY_INVESTIGATIONS={{ sherlog_daily_investigations }}
MODEL_API_KEY={{ sherlog_model_api_key }}
{% if sherlog_model_provider %}
MODEL_PROVIDER={{ sherlog_model_provider }}
{% endif %}
{% if sherlog_model_upstream %}
MODEL_UPSTREAM={{ sherlog_model_upstream }}
{% endif %}
GITHUB_ISSUES_REPO={{ sherlog_github_issues_repo }}
GITHUB_ISSUES_TOKEN={{ sherlog_github_issues_token }}
GITHUB_AUTOFIX={{ sherlog_github_autofix }}
ALERT_SLACK_WEBHOOK_URL={{ sherlog_alert_slack_webhook_url }}
DEADMAN_URL={{ sherlog_deadman_url }}
DOCKER_DIAGNOSTICS={{ '1' if sherlog_docker_diagnostics else '' }}
ACTIONS={{ '1' if sherlog_actions else '' }}
