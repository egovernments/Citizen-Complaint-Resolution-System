{
  "uid": "pgr-analytics",
  "title": "DIGIT \u2014 PGR Analytics Queries",
  "tags": [
    "digit",
    "pgr",
    "analytics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Server-side analytics query metrics emitted by pgr-services (AnalyticsMetrics.java). NOTE: `tenant` is the STATE-ROOT tenant (e.g. `ke`), never the city tenant \u2014 the raw request tenantId is caller-controlled and tagging it would let an anonymous caller mint a series per request. Panels are empty until the analytics query path is exercised: the instruments register lazily on first use, so before any analytics query runs the series do not exist and the tenant/kpi_id/grain variables offer no values. That needs KPIs seeded on the tenant. Not a fault.",
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant (state root)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pgr_analytics_query_rows_total, tenant)",
        "definition": "label_values(pgr_analytics_query_rows_total, tenant)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "kpi_id",
        "label": "KPI",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pgr_analytics_query_rows_total, kpi_id)",
        "definition": "label_values(pgr_analytics_query_rows_total, kpi_id)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "grain",
        "label": "Planner grain",
        "description": "facts / events / daily. The 'Duration by planner grain' panel already splits by grain in its legend; this isolates one.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(pgr_analytics_query_rows_total, grain)",
        "definition": "label_values(pgr_analytics_query_rows_total, grain)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Query duration percentiles",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pgr_analytics_query_duration_ms_bucket{kpi_id=~\"$kpi_id\", tenant=~\"$tenant\", grain=~\"$grain\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pgr_analytics_query_duration_ms_bucket{kpi_id=~\"$kpi_id\", tenant=~\"$tenant\", grain=~\"$grain\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pgr_analytics_query_duration_ms_bucket{kpi_id=~\"$kpi_id\", tenant=~\"$tenant\", grain=~\"$grain\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "description": "Duration of one executed analytics SQL query. Derived from the pgr_analytics_query_duration_ms histogram; see docs/observability/dashboard-metrics.md."
    },
    {
      "id": 2,
      "title": "p95 duration by KPI",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (kpi_id, le) (rate(pgr_analytics_query_duration_ms_bucket{kpi_id=~\"$kpi_id\", tenant=~\"$tenant\", grain=~\"$grain\"}[$__rate_interval])))",
          "legendFormat": "{{kpi_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "description": "Which KPI is expensive. Query taken from the metric documentation."
    },
    {
      "id": 3,
      "title": "Query rate by KPI",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kpi_id) (rate(pgr_analytics_query_duration_ms_count{kpi_id=~\"$kpi_id\", tenant=~\"$tenant\", grain=~\"$grain\"}[$__rate_interval]))",
          "legendFormat": "{{kpi_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Rows scanned per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kpi_id) (rate(pgr_analytics_query_rows_total{kpi_id=~\"$kpi_id\", tenant=~\"$tenant\", grain=~\"$grain\"}[$__rate_interval]))",
          "legendFormat": "{{kpi_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "description": "Rising rows/sec at a flat query rate means the dataset is growing under the same queries \u2014 the early signal that analytics will get slower."
    },
    {
      "id": 5,
      "title": "Duration by planner grain",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (grain, le) (rate(pgr_analytics_query_duration_ms_bucket{kpi_id=~\"$kpi_id\", tenant=~\"$tenant\", grain=~\"$grain\"}[$__rate_interval])))",
          "legendFormat": "{{grain}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "description": "facts / events / daily. Shows whether the planner is choosing the cheap pre-aggregated grain or falling back to raw facts."
    },
    {
      "id": 6,
      "title": "Slowest KPIs by mean duration",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(5, sum by (kpi_id) (rate(pgr_analytics_query_duration_ms_sum{kpi_id=~\"$kpi_id\", tenant=~\"$tenant\", grain=~\"$grain\"}[$__rate_interval])) / sum by (kpi_id) (rate(pgr_analytics_query_duration_ms_count{kpi_id=~\"$kpi_id\", tenant=~\"$tenant\", grain=~\"$grain\"}[$__rate_interval])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "description": "Verbatim from docs/observability/dashboard-metrics.md."
    },
    {
      "id": 7,
      "title": "Queries executed (selected range)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pgr_analytics_query_duration_ms_count{kpi_id=~\"$kpi_id\", tenant=~\"$tenant\", grain=~\"$grain\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Rows scanned (selected range)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pgr_analytics_query_rows_total{kpi_id=~\"$kpi_id\", tenant=~\"$tenant\", grain=~\"$grain\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}