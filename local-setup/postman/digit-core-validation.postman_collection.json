									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Smoke Tests",
			"description": "Minimal functional checks that validate common data paths using seeded data.",
			"item": [
				{
					"name": "MDMS search (tenant master)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"RequestInfo\": { \"apiId\": \"digit\", \"ver\": \"1.0\", \"ts\": 0 },\n  \"MdmsCriteria\": {\n    \"tenantId\": \"pg\",\n    \"moduleDetails\": [\n      { \"moduleName\": \"tenant\", \"masterDetails\": [ { \"name\": \"tenants\" } ] }\n    ]\n  }\n}"
						},
						"url": "{{baseUrl}}/mdms-v2/v1/_search",
						"description": "Queries tenant master data from MDMS using seeded data (tenantId pg)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"MDMS search (tenant master) returns 2xx\", function () {",
									"    pm.response.to.be.success;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Localization search (v1)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"RequestInfo\": { \"apiId\": \"Rainmaker\", \"ver\": \".01\", \"ts\": \"\" }\n}"
						},
						"url": "{{baseUrl}}/localization/messages/v1/_search?locale=en_IN&module=rainmaker-workbench&tenantId=pg",
						"description": "Fetches localization messages (v1). If empty, run the cache-bust request first."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Localization search (v1) returns 2xx\", function () {",
									"    pm.response.to.be.success;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Localization cache-bust",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/localization/messages/cache-bust",
						"description": "Clears Redis cache for localization messages."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Localization cache-bust returns 2xx\", function () {",
									"    pm.response.to.be.success;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Boundary-service hierarchy search",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"RequestInfo\": {\n    \"apiId\": \"digit\",\n    \"ver\": \"1.0\",\n    \"ts\": 0\n  },\n  \"BoundaryTypeHierarchySearchCriteria\": {\n    \"tenantId\": \"{{tenantId}}\"\n  }\n}"
						},
						"url": "{{baseUrl}}/boundary-service/boundary-hierarchy-definition/_search?tenantId=pg",
						"description": "Fetches boundary hierarchy definitions from boundary-service v2."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Boundary-service hierarchy search returns 2xx\", function () {",
									"    pm.response.to.be.success;",
									"});"
								]
							}
						}
					]
				}
			]
		}
	]
}