{
	"info": {
		"name": "DIGIT Core Services - Local Validation",
		"description": "Smoke tests and health checks for the DIGIT core services running via docker compose on localhost. Update the baseUrl variable if you are not using localhost.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:18000",
			"description": "Kong gateway URL. Override per env: http://localhost:18000 (local), https://<tenant>.example.com (prod)."
		},
		{
			"key": "tenantId",
			"value": "pg",
			"description": "Root tenant used by the master-data sanity requests."
		}
	],
	"item": [
		{
			"name": "Health Checks",
			"description": "Quick liveness checks for all HTTP services in the compose file.",
			"item": [
				{
					"name": "MDMS health",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/mdms-v2/health",
						"description": "Verifies the MDMS service is up and responding."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"MDMS health returns 2xx\", function () {",
									"    pm.response.to.be.success;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "ENC service health",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/egov-enc-service/actuator/health",
						"description": "Checks egov-enc-service actuator health."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"ENC service health returns 2xx\", function () {",
									"    pm.response.to.be.success;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "IDGEN health",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/egov-idgen/health",
						"description": "Checks egov-idgen health endpoint."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"IDGEN health returns 2xx\", function () {",
									"    pm.response.to.be.success;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "User health",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/user/health",
						"description": "Checks egov-user health endpoint."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"User health returns 2xx\", function () {",
									"    pm.response.to.be.success;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Workflow v2 health",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/egov-workflow-v2/health",
						"description": "Checks egov-workflow-v2 health endpoint."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Workflow v2 health returns 2xx\", function () {",
									"    pm.response.to.be.success;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Localization health",
					"request": {
