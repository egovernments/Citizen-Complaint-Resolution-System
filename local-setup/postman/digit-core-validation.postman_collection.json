					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Localization health returns 2xx\", function () {",
									"    pm.response.to.be.success;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Boundary-service health",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/boundary-service/actuator/health",
						"description": "Checks boundary-service (v2) actuator health."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Boundary-service health returns 2xx\", function () {",
									"    pm.response.to.be.success;",
									"});"
								]
							}
