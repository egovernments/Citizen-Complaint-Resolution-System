# Copy this file to .env (same folder) and paste your key. .env is git-ignored; never commit real keys.
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# Optional settings
# GEMINI_MODEL=gemini-3.5-flash-lite
# BATCH_SIZE=80
# REQUESTS_PER_MINUTE=10

# To use the other supported provider instead:
# LLM_PROVIDER=groq
# GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# GROQ_MODEL=openai/gpt-oss-120b

# To split one labelling run across several keys (each from a separate project), define more variables with any
# names and pass the name with --key-env, giving each process its own row range, for example:
#   GEMINI_API_KEY_2=PASTE_ANOTHER_KEY_HERE
#   python labelling/pipeline.py label --run-id r2 --model gemini-3.1-flash-lite --start 20000 --key-env GEMINI_API_KEY_2
