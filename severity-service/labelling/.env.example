# Copy this file to .env (same folder) and paste your key. .env is git-ignored.
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# BATCH_SIZE=80
# REQUESTS_PER_MINUTE=10

# To use Groq instead (free key: console.groq.com/keys):
# LLM_PROVIDER=groq
# GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# GROQ_MODEL=openai/gpt-oss-120b
