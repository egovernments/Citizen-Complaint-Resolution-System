# DIGIT Integration Tests — environment template
#
# A real box keeps these in two files (deploy/README.md):
#   deploy/<env>.env   tracked, no secrets (everything above "Secrets")
#   secrets file       box-local, mode 0600, path in RUNNER_SECRETS_ENV
# Nothing has a default that names a box: profile-setup fails fast naming
# whatever required value is missing.

# ── Target (required) ────────────────────────────────────────────────────────
BASE_URL=https://deployment.example
# The workspace's ROOT tenant; the slug must resolve to it.
DIGIT_TENANT=
IDENTITY_TEST_TENANT_SLUG=
KC_REALM=digit
EXPECTATIONS_FILE=deploy/expectations/default.json
# IGNORE_HTTPS_ERRORS=1          # self-signed boxes only

# ── Personas: Keycloak logins (scripts/seed-personas.ts creates them) ─────────
ADMIN_LOGIN=it-admin@deployment.test          # required; ACCOUNT_ADMIN
GRO_LOGIN=it-gro@deployment.test
LME_LOGIN=it-lme@deployment.test
WARD_CSR_LOGIN=it-ward-csr@deployment.test
INBOX_VIEWER_LOGIN=it-inbox-viewer@deployment.test
SUPERVISOR_LOGIN=it-supervisor@deployment.test
# A Keycloak login with no DIGIT user or roles, for employee/login.spec.ts's
# wrong-password check (brute-force lockout lands on it, never on a persona).
# Required by that spec; seed-personas.ts creates it and writes its password.
LOGIN_PROBE_LOGIN=it-login-probe@deployment.test

# ── Seed data (optional pins; profile-setup discovers them) ──────────────────
# SERVICE_CODE=
# LOCALITY_CODE=
# WARD_CSR_BOUNDARY=
# FORBIDDEN_WARDS=

# ── Dashboard benchmarks only (playwright.dashboard.config.ts) ───────────────
# The 'department' principal: a department-scoped employee, no default.
# DASHBOARD_DEPARTMENT_LOGIN=
# DASHBOARD_DEPARTMENT_PASSWORD=          # secrets file

# ── Secrets: these belong in the box secrets file, never in git ──────────────
ADMIN_PASSWORD=
GRO_PASSWORD=
LME_PASSWORD=
WARD_CSR_PASSWORD=
INBOX_VIEWER_PASSWORD=
SUPERVISOR_PASSWORD=
LOGIN_PROBE_PASSWORD=
# The box's fixed citizen OTP; required whenever citizen specs run.
IDENTITY_TEST_OTP_CODE=
