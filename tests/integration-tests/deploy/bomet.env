# Bomet deploy config for the integration-tests suite + dashboards.
#
# Public config only — NO secrets. Basic-auth creds live in
# /etc/nginx/.htpasswd-tests on the box, never here.
#
# Usage (from a runner that can ssh to `bomet`):
#   set -a; source deploy/bomet.env; set +a
#   make test-and-publish
#
# Every value below overrides a default that points at naipepea, so the
# same branch deploys to any tenant by swapping this file.

# Which capabilities this deployment SHOULD have. Discovery decides HOW to test;
# this decides whether a missing capability is a bug (fail) or N/A (skip).
export EXPECTATIONS_FILE=deploy/expectations/bomet.json

# ── Suite target (read-mostly black-box client against the live API) ──────────
export BASE_URL=https://bometfeedbackhub.digit.org
export DIGIT_TENANT=ke            # bomet is single-level `ke`, NOT ke.nairobi
export ROOT_TENANT=ke
export TENANT_LABEL="Bomet County"

# Citizen complaint creation needs a real bomet locality + service code.
# `IllegalConstruction` (the naipepea default) does NOT exist on bomet.
export LOCALITY_CODE=BOMET_BOMET_CENTRAL_CHESOEN
export SERVICE_CODE=RudeBehavior

# Personas (BOMET_LME / BOMET_CSR_CHESOEN_… / ward boundaries) are already the
# defaults in tests/utils/env.ts, so they're omitted here on purpose.

# ...with two exceptions. GRO_USER and EMPLOYEE_USER default to ADMIN, which
# env.ts is explicit is only safe "on a stock deployment" where tenant_bootstrap
# granted ADMIN the GRO + PGR_LME bundle. Bomet is not that deployment: ADMIN
# here has NO HRMS employee record at ke, so pgr-services cannot resolve a
# department or jurisdiction for it —
#   PolicyDrivenScopeResolver: userName='ADMIN' — no HRMS employee for 'ADMIN'
#   — resolving via policy with no HRMS axis data: departments=null jurisdictions=null
# — and the ASSIGN in api/pgr-lifecycle step 3 is refused. That single refusal
# cascades: pgr-escalation (11), pgr-lifecycle (2), full-complaint-lifecycle-ui
# (2), pgr-inbox-sort-922 (3) and pgr-sla-auto-escalate (1) all skip behind it,
# ~22 tests that never get to assert anything. deploy/expectations/bomet.json
# has flagged this as the largest gap since 2026-07-16.
#
# HS_GRO and HS_LME are real EMPLOYED HRMS records at ke sharing department
# DEPT_1 (a matched GRO -> LME pair, which is what the PGR routing wants), and
# profile.setup's persona probe already logs both in successfully against this
# deployment. Prefer them over ADMIN explicitly rather than relying on the
# bootstrap having granted ADMIN a role bundle it cannot use without an
# employee record.
export GRO_USER=HS_GRO
export GRO_PASSWORD=eGov@123
# HS_SU rather than HS_LME: PGR's jurisdiction axis is EXACT-match on the
# complaint's locality (PGRQueryBuilder: ads.locality IN (jurisdictionCodes)),
# so under the authored ABAC policy an LME persona needs either a jurisdiction
# row per ward or SUPERVISOR (jurisdiction=ALL) to read back what it acts on.
# HS_SU holds GRO (department=ALL) + PGR_LME (may RESOLVE) + SUPERVISOR, so it
# can both see and close complaints anywhere on the tenant.
export EMPLOYEE_USER=HS_SU
export EMPLOYEE_PASSWORD=eGov@123

# Configurator tenants-search test. NOTE: bomet is a single-tenant `ke`
# deployment — there is no city sub-tenant, and the configurator's mdms-v2
# tenant.tenants master holds only test-created ke.pwt*/ke.tgt* junk. So this
# test is environmentally N/A here (no real city tenant to search for); `ke`
# is the honest target even though the configurator list may not surface it.
export CITY_TENANT=ke

# pgr-postal-code spec logs in as a "city admin"; naipepea's default
# EMP-KE_NAIROBI-000089 doesn't exist on bomet → use a real bomet employee.
# BOMET_LME authenticates but has NO HRMS employee record, so under enforced
# ABAC it resolves no department/jurisdiction and its inbox is empty. HS_SU is
# a real EMPLOYED record whose code equals its username.
export CITY_ADMIN_USER=HS_SU
export CITY_ADMIN_PASS=eGov@123

# ── Publish target ────────────────────────────────────────────────────────────
export HOST_SSH=bomet
export HOST_DIR=/opt/integration-tests/dist          # vanilla dashboard + catalog.json + runs/
export BRANCH=feat/bomet-integration-deploy

# ── React-admin (v2) dashboard build base ─────────────────────────────────────
# Served at /tests-v2/ on the bomet vhost.
export DASHBOARD_BASE=/tests-v2/
export TESTS_PROXY_TARGET=https://bometfeedbackhub.digit.org
