# Bomet deploy config for the integration-tests suite + dashboards.
#
# Public config only — NO secrets. Basic-auth creds live in
# /etc/nginx/.htpasswd-tests on the box, never here. Since v2.20 staff sign in
# through Keycloak + the Identity BFF, so the passwords and the citizen OTP
# come from a box-local secrets file (mode 0600, never committed) that sets:
#   ADMIN_PASSWORD, CITY_ADMIN_PASS, EMPLOYEE_PASSWORD, WARD_CSR_PASSWORD,
#   IDENTITY_TEST_OTP_CODE
#
# Usage (from a runner that can ssh to `bomet`):
#   set -a; source deploy/bomet.env; source <secrets file>; set +a
#   make test-and-publish
#
# Every value below overrides a default that points at naipepea, so the
# same branch deploys to any tenant by swapping this file.

# Which capabilities this deployment SHOULD have. Discovery decides HOW to test;
# this decides whether a missing capability is a bug (fail) or N/A (skip).
export EXPECTATIONS_FILE=deploy/expectations/bomet.json

# ── Suite target ─────────────────────────────────────────────────────────────
# Inputs only. The tenant (ke), its label, the boundary leaf and the complaint
# type every seeded complaint uses are DISCOVERED per run (profile.setup) from
# the workspace slug below, so nothing here pins bomet's data.
export BASE_URL=https://bometfeedbackhub.digit.org

# ── Identity (v2.20: Keycloak + Identity BFF) ────────────────────────────────
# Workspace slug -> root tenant `ke` (GET /identity/v1/tenant-contexts/ke).
export IDENTITY_TEST_TENANT_SLUG=ke

# ── Personas: Keycloak logins (email), not DIGIT usernames ───────────────────
# Each is a Keycloak user in realm `digit` bound to its DIGIT employee at `ke`.
# The old DIGIT codes (ADMIN, HS_GRO, HS_SU) are not Keycloak logins, so a
# sign-in with them is refused and profile discovery stops the whole run.
#
# Workspace admin (KE_ACCOUNT_ADMIN: SUPERUSER, MDMS_ADMIN, LOC_ADMIN, ...).
export ADMIN_USER=ke-admin@staff.bometfeedbackhub.digit.org
# pgr-postal-code's "city admin".
export CITY_ADMIN_USER=ke-admin@staff.bometfeedbackhub.digit.org
# HS_LME: PGR_LME in DEPT_1, jurisdiction BOMET_BOMET_CENTRAL_CHESOEN.
export EMPLOYEE_USER=hs_lme@staff.bometfeedbackhub.digit.org
# CHESOEN ward CSR (boundary-jurisdiction-496).
export WARD_CSR_USER=bomet_csr_chesoen_1780282462@staff.bometfeedbackhub.digit.org
#
# GRO: no employee with the GRO role has a Keycloak login on bomet yet (HS_GRO
# and HS_SU were never linked), so GRO_USER is left unset and falls back to
# ADMIN_USER, which has no GRO role. Discovery then reports the seed plan as
# UNRESOLVED and the ASSIGN-dependent specs skip with that reason. Link a GRO
# with a department (and SUPERVISOR or a CHESOEN jurisdiction) and set GRO_USER
# here to close the gap.
#
# employee/login.spec.ts needs LOGIN_PROBE_LOGIN: a Keycloak user in realm
# `digit` with NO DIGIT link (it receives the wrong-password attempts, so
# brute-force protection never locks a real persona). None exists on bomet yet.
#
# Never guess passwords for HRMS codes: they are not Keycloak logins.
export PERSONA_PASSWORD_GUESSES=


# ── Publish target ────────────────────────────────────────────────────────────
export HOST_SSH=bomet
export HOST_DIR=/opt/integration-tests/dist          # vanilla dashboard + catalog.json + runs/
export BRANCH=feat/bomet-integration-deploy

# ── React-admin (v2) dashboard build base ─────────────────────────────────────
# Served at /tests-v2/ on the bomet vhost.
export DASHBOARD_BASE=/tests-v2/
export TESTS_PROXY_TARGET=https://bometfeedbackhub.digit.org
