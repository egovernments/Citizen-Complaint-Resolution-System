# bomet: tests `master` (#2398 decision 1). Env profile for the integration suite.
#
# Tracked, NO secrets: persona passwords live in the box-local secrets file
# (RUNNER_SECRETS_ENV); basic-auth creds in /etc/nginx/.htpasswd-tests.
#
#   set -a; source deploy/bomet.env; source "$RUNNER_SECRETS_ENV"; set +a
#   make test-and-publish
export EXPECTATIONS_FILE=deploy/expectations/bomet.json

# ── Target: the single root tenant `ke` ───────────────────────────────────────
export BASE_URL=https://bometfeedbackhub.digit.org
export DIGIT_TENANT=ke
export KC_REALM=digit
# master has no identity-bff yet, so no workspace slug; set it when Bomet takes
# #1999 (the deploy then records the seeded workspace as DONE, #2398 A0).
export IDENTITY_TEST_TENANT_SLUG=

# Citizen complaint creation needs a real bomet locality + service code.
export LOCALITY_CODE=BOMET_BOMET_CENTRAL_CHESOEN
export SERVICE_CODE=RudeBehavior

# ── Personas: sign-in logins (DIGIT usernames on master) ──────────────────────
# ADMIN has no HRMS record at ke, so it cannot ASSIGN. HS_GRO is an EMPLOYED GRO
# in DEPT_1; HS_SU holds GRO (department=ALL) + PGR_LME + SUPERVISOR, so it sees
# and closes complaints anywhere: PGR's jurisdiction axis is EXACT-match on the
# complaint's locality, and only SUPERVISOR maps to jurisdiction=ALL.
export ADMIN_LOGIN=ADMIN
export GRO_LOGIN=HS_GRO
export SUPERVISOR_LOGIN=HS_SU
export WARD_CSR_LOGIN=BOMET_CSR_CHESOEN_1780282462

# ── Publish target ────────────────────────────────────────────────────────────
export HOST_SSH=bomet
export HOST_DIR=/opt/integration-tests/dist          # vanilla dashboard + catalog.json + runs/
export BRANCH=feat/bomet-integration-deploy

# ── React-admin (v2) dashboard build base ─────────────────────────────────────
# Served at /tests-v2/ on the bomet vhost.
export DASHBOARD_BASE=/tests-v2/
export TESTS_PROXY_TARGET=https://bometfeedbackhub.digit.org
