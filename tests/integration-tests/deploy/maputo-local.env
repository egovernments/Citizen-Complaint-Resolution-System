# Local v2.20 stack config for the integration-tests suite.
#
# Public config only — NO secrets.
#
# Since v2.20 staff sign in through Keycloak + the Identity BFF with their
# email, and every page lives under a workspace slug (/{slug}/digit-ui/...).
# The old target (city tenant mz.maputo, DIGIT usernames ADMIN / EMP001)
# cannot sign in any more: city-tenant staff cannot be linked to Keycloak.
# So the suite runs against a self-serve WORKSPACE on the local stack, built
# with the suite's own onboarding helpers (tests/utils/workspace-setup.ts):
#   signup -> Branding -> Geography (E2E_COUNTY > E2E_WARD_A/B) -> Departments
#   (WATER, ROADS) -> Employees (GRO in WATER scoped to E2E_WARD_A, GRO in ROADS,
#   LME in WATER) -> Complaint types (WaterLeak, RoadsPothole).
#
# Seed one with `npx tsx scripts/seed-workspace.ts <slug> <outdir>`; it writes:
#   workspace.env  slug + persona logins (emails)               — public
#   secrets.env    persona passwords + citizen OTP (mode 0600)  — never commit
#
# Usage:
#   set -a; source deploy/maputo-local.env; source <seed>/workspace.env; source <seed>/secrets.env; set +a
#   npx playwright test
#
# Deployment prerequisites (host_vars): enable_keycloak, Mailpit SMTP,
# identity_citizen_signin_methods: [phone_otp] and identity_dev_fixed_otp: true.

# Which capabilities this deployment SHOULD have. Discovery decides HOW to test;
# this decides whether a missing capability is a bug (fail) or N/A (skip).
export EXPECTATIONS_FILE=deploy/expectations/maputo-local.json

# ── Suite target ─────────────────────────────────────────────────────────────
export BASE_URL=http://localhost
export LOCAL_STACK=1                  # opt in to @local-only specs
# Loopback port of the local identity-bff container (its /readyz is not routed by nginx/Kong).
export IDENTITY_BFF_URL=http://127.0.0.1:18400
# Everything else (tenant, boundary leaf, complaint type, mobile/postal rules,
# locales, id prefix, which persona holds which role) is discovered per run
# from the workspace slug in workspace.env.

# Never guess passwords for HRMS codes: they are not Keycloak logins.
export PERSONA_PASSWORD_GUESSES=
