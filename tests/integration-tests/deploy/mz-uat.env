# UAT falacidadao (Maputo) deploy config for the integration-tests suite.
#
# Public config only — NO secrets.
#
# Usage:
#   set -a; source deploy/mz-uat.env; set +a
#   npx playwright test --project=profile-setup   # discovery first, before anything else
#
# STATUS: prep only — NOT yet run against the live environment. See the
# "KNOWN GAPS" block at the bottom before running anything beyond
# profile-setup discovery.
#
# This tenant's PGR workflow is NOT the GRO/PGR_LME model the suite defaults
# to (bomet/naipepea) — it is a 5-role case-management chain:
#   PENDINGFORASSIGNMENT --ASSIGN(CMS_SCREENING_OFFICER)--> REFERRED
#   REFERRED --ASSIGN(CMS_SUPERVISOR)--> INVESTIGATION
#   INVESTIGATION --RESOLVE/REJECT/AWAITINGINFORMATION(CMS_CASE_MANAGER)-->
#   RESOLVED/REJECTED are terminal-adjacent (RATE, REOPEN); no GRO role exists.

# ── Suite target ─────────────────────────────────────────────────────────────
export BASE_URL=https://uat.falacidadao.gov.mz
export DIGIT_TENANT=mz
export ROOT_TENANT=mz
# TODO: confirm the label shown in the digit-ui login City combobox for `mz`.
# export TENANT_LABEL="TODO"

# ── Admin credentials ────────────────────────────────────────────────────────
export DIGIT_USERNAME=ADMIN
export DIGIT_PASSWORD=eGov@123
export ADMIN_USER=ADMIN
export ADMIN_PASSWORD=eGov@123

# ── Citizen complaint creation ───────────────────────────────────────────────
# TODO: no SERVICE_CODE / LOCALITY_CODE given yet. Leaving unset lets
# resolveFilingTarget() pick the first complaint type + boundary leaf found
# during profile-setup discovery — confirm those picks are sane before
# trusting create-complaint specs.
# export SERVICE_CODE=TODO
# export LOCALITY_CODE=TODO

# MZ mobile rule is ^8[0-9]{8}$ (9 digits, +258) per the existing
# maputo-local.env. The value "800000001" given for this tenant is a full
# 9-digit sample number, not a prefix — using it verbatim would make every
# generated citizen phone number identical (PHONE_LENGTH - prefix.length = 0,
# see tests/utils/env.ts phoneFromSeed). Using just the leading digit instead
# so generated numbers stay unique per run.
export CITIZEN_PHONE_PREFIX=8

# TODO: confirm OTP behavior. Unlike some lower environments, "UAT" naming
# suggests this may NOT have a fixed/mock OTP (bomet's fixed-OTP-by-default
# was itself flagged as a P0 security bug elsewhere in this repo's history —
# see issue #1669). If there is no fixed OTP, citizen UI login specs that
# depend on FIXED_OTP will need a different login strategy here.
# export FIXED_OTP=TODO

# ── Personas ─────────────────────────────────────────────────────────────────
# KNOWN GAP: tests/utils/personas.ts hardcodes role lookups for GRO / PGR_LME /
# CSR, none of which exist on this tenant's workflow (see header). Only the
# 'employee' persona (role EMPLOYEE) will resolve as-is:
#   EMP021  EMPLOYEE, CMS_RECEPTION_OFFICER
#   EMP041  EMPLOYEE, CMS_CASE_MANAGER
#   EMP061  EMPLOYEE, CMS_CASE_MANAGER
#   EMP081  EMPLOYEE, CMS_SUPERVISOR
# ASSIGN-dependent seeding (resolveSeedPlan, driveToPendingAtLme, etc.) will
# fail to resolve an actor until personas.ts is taught to pick an actor from
# the workflow's own action-role list instead of a hardcoded 'GRO' string.
# This is a code change to shared logic, not a config value — do not paper
# over it with env vars pointing GRO_USER at a CMS_* account; matches() checks
# the literal role string and will still reject it.
export EMPLOYEE_USER=EMP021
export EMPLOYEE_PASSWORD=eGov@123

# Left unset deliberately — no persona on this tenant satisfies WARD_CSR_* or
# FORBIDDEN_WARDS' assumptions (CSR role doesn't exist here); dependent specs
# will skip themselves with a precise reason rather than asserting wrong data.
