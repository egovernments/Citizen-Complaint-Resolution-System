# naipepea: tests `develop` (#2398 decision 1). Env profile for the integration suite.
#
# Tracked, NO secrets. The persona passwords and the fixed OTP live in the
# box-local secrets file (RUNNER_SECRETS_ENV, mode 0600, runner-only); see
# deploy/README.md. Every value that differs per box lives here or in
# deploy/expectations/naipepea.json, never in the suite.
#
#   set -a; source deploy/naipepea.env; source "$RUNNER_SECRETS_ENV"; set +a
#   npx playwright test

export EXPECTATIONS_FILE=deploy/expectations/naipepea.json

# ── Target: one root workspace created through Configurator signup ────────────
export BASE_URL=https://naipepea.digit.org
# TODO(#2398 A0): set both once the reset workspace exists. Until then the run
# stops in profile-setup naming them.
export IDENTITY_TEST_TENANT_SLUG=
export DIGIT_TENANT=
export KC_REALM=digit

# ── Personas: Keycloak logins (placeholder test-domain addresses) ─────────────
# scripts/seed-personas.ts creates each as a DIGIT employee at DIGIT_TENANT,
# linked to this login; it writes the matching <ROLE>_PASSWORD to the secrets
# file and prints SERVICE_CODE / LOCALITY_CODE / WARD_CSR_BOUNDARY for below.
export ADMIN_LOGIN=it-admin@naipepea.test
export GRO_LOGIN=it-gro@naipepea.test
export LME_LOGIN=it-lme@naipepea.test
export WARD_CSR_LOGIN=it-ward-csr@naipepea.test
export INBOX_VIEWER_LOGIN=it-inbox-viewer@naipepea.test
export SUPERVISOR_LOGIN=it-supervisor@naipepea.test
# A Keycloak login with no DIGIT user or roles: employee/login.spec.ts posts
# wrong passwords to it, so brute-force protection never locks a persona.
export LOGIN_PROBE_LOGIN=it-login-probe@naipepea.test

# ── Seed data (from seed-personas.ts; profile-setup discovers them when unset) ─
# export SERVICE_CODE=
# export LOCALITY_CODE=
# export WARD_CSR_BOUNDARY=
