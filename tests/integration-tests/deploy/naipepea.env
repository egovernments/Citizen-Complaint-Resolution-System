# naipepea: tests `develop` (#2398). Env profile for the integration suite.
#
# Public config only, NO secrets. The passwords and the fixed OTP come from a
# box-local secrets file (mode 0600, never committed) that sets:
#   ADMIN_PASSWORD, EMPLOYEE_PASSWORD, GRO_PASSWORD, WARD_CSR_PASSWORD,
#   IDENTITY_TEST_OTP_CODE
# and, optionally, PERSONA_CANDIDATES=<login>:<password>,... for more personas.
#
#   set -a; source deploy/naipepea.env; source <secrets file>; set +a
#   npx playwright test
#
# Staff sign in through Keycloak and the Identity BFF (#1999), so every *_USER
# below is a Keycloak login (email), not a DIGIT username.

# ── Target: an existing root workspace created through Configurator signup ────
export BASE_URL=https://naipepea.digit.org
# Workspace slug -> its root tenant (signup makes the tenant id from the slug).
export IDENTITY_TEST_TENANT_SLUG=qa2398
export DIGIT_TENANT=qa
export KC_REALM=digit

# ── Personas: Keycloak logins of the workspace's employees ───────────────────
export ADMIN_USER=it2-admin@naipepea.test
export EMPLOYEE_USER=it2-lme@naipepea.test
export GRO_USER=it2-gro@naipepea.test
export WARD_CSR_USER=it2-ward-csr@naipepea.test
# A Keycloak login with no DIGIT user or roles: employee/login.spec.ts posts
# wrong passwords to it, so brute-force protection never locks a persona.
export LOGIN_PROBE_LOGIN=it2-login-probe@naipepea.test
# Persona discovery must not guess passwords for HRMS codes: those are not
# Keycloak logins, so every guess is only a failed sign-in.
export PERSONA_PASSWORD_GUESSES=
