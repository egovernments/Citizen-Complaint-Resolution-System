# Local `pg` (playground) stack config for the integration-tests suite.
#
# Public config only — NO secrets (local dev passwords are the stock eGov@123).
#
# Usage:
#   set -a; source deploy/pg.env; set +a
#   npx playwright test
#
# Targets the local DIGIT stack at /opt/digit deployed via
# local-setup/ansible/deploy.sh playground, whose seed data comes from
# local-setup/db/full-dump.sql rather than hand-run XLSX onboarding.
#
# WHY pg RATHER THAN mz/ke: `pg` is the tenant full-dump.sql seeds natively, so the
# deployment's data is version-controlled and reproducible from a clean volume. mz
# (maputo) and ke (bomet) accumulated their seed state by hand, which is why a
# from-scratch deploy of either cannot run this suite at all.
#
# pg is FLAT for testing. The dump ships pg.citya/citest/cityb/cityc as tenant rows,
# but the PGR businessService and every complaint type sit at the ROOT `pg`. Pointing
# the suite at a pg.* city gives a tenant with no PGR config — complaints create but
# cannot be found, inboxes are empty, and ~20 specs fail spuriously.
export EXPECTATIONS_FILE=deploy/expectations/pg.json

export BASE_URL=http://localhost
export DIGIT_TENANT=pg
export ROOT_TENANT=pg
export CITY_TENANT=pg
export LOCAL_STACK=1

# auth.setup.ts walks the configurator login form and reads its own TENANT_CODE/
# ADMIN_USER vars (not DIGIT_TENANT/DIGIT_USERNAME).
export TENANT_CODE=pg
export ADMIN_USER=ADMIN
export ADMIN_PASSWORD=eGov@123

# ComplaintHierarchy leaves carry department + slaHours; a leaf is what a complaint's
# serviceCode points at, and its department is what makes an ASSIGN resolvable.
export SERVICE_CODE=BurningOfGarbage
export LOCALITY_CODE=SUN01_LOCALITY
export CITIZEN_PHONE_PREFIX=9         # pg mobile rule is ^[6-9][0-9]{9}$ (+91)
export PGR_ID_PREFIX=PG

# Personas deliberately NOT pinned — profile-setup resolves them live. Hand-pinning a
# username that lacks the required role produces a confusing mid-suite 400 rather than
# an honest "persona unresolved" diagnostic.

export POSTAL_CODE_PATTERN='^[1-9][0-9]{5}$'
export POSTAL_CODE_VALID=143001
export LOCALES=en_IN
