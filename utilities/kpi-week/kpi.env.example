# Copy to kpi.env, fill in, chmod 600. kpi.env is gitignored; keep it that way.
# A real environment variable always wins over this file, so cron can override it.

# ---- required -------------------------------------------------------------
# No defaults on purpose: a wrong one silently reports another deployment.
BASE_URL=https://pgr.example.gov
TENANT_ID=

# Either paste a short-lived token, or leave it empty and set the service
# account below so the script mints its own. Unattended runs need the account.
AUTH_TOKEN=
PGR_USERNAME=
PGR_PASSWORD=

# ---- strongly recommended -------------------------------------------------
# Decides which local day a timestamp belongs to. Left at UTC on a deployment
# that is not, week boundaries drift by the offset.
TZ_NAME=UTC

# ---- optional -------------------------------------------------------------
# Week 1 of a programme tracking sheet. Unset -> ISO week numbers (W38).
# WEEK1_START=2026-08-31

# Only if the deployment's OAuth differs from the DIGIT default.
# PGR_USER_TYPE=EMPLOYEE
# OAUTH_CLIENT_ID=egov-user-client
# OAUTH_CLIENT_SECRET=

# Web-analytics columns. Unset -> those stay "-".
MATOMO_URL=https://<matomo-host>/index.php
MATOMO_TOKEN=
MATOMO_SITE_ID=1

# Authentication and notification columns, read via `docker exec psql`.
# Unset -> those stay "-".
PG_CONTAINER=
# PG_USER=postgres
# PG_DB=postgres

# Login referers, if the UI is served from nonstandard paths. Defaults cover
# both the v2 SPA (/citizen, /employee) and older builds (/digit-ui/<role>).
# CITIZEN_PATHS=/digit-ui/citizen,/citizen
# EMPLOYEE_PATHS=/digit-ui/employee,/employee

# Successful-login counts. Bounded by log rotation: if the logs no longer reach
# the week's start, the column is "-" rather than an undercount.
# NGINX_ACCESS_GLOB=/var/log/nginx/access.log*

# ---- host with no public DNS ----------------------------------------------
# Point at kong on the box and let it match the public route by Host header.
# BASE_URL=http://localhost:8000
# MATOMO_URL=http://localhost:8000/matomo/index.php
# HTTP_HOST_HEADER=pgr.example.gov
